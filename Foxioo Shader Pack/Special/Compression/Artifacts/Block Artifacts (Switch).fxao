/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform bool _Blending_Mode;
uniform float _Seed;
uniform float _Mixing;
uniform float _Distortion;

/************************************************************/
/* Main */
/************************************************************/

vec2 Fun_Rand(vec2 In)
{
    vec2 _Rand = vec2(  fract(sin(dot(In.xy + _Seed, vec2(12.9898,78.233)))* 43758.5453123),
                        fract(cos(dot(In.xy + _Seed, vec2(67.4684,18.467)))* 3463456.95546)
                        );
    return _Rand;
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec2 _Pixel = vec2(fPixelWidth, fPixelHeight);
        vec2 _Block = vec2(4.0, 8.0);
        vec4 _Result = vec4(0.0);
        vec4 _Render = vec4(0.0);

            vec2 _Art = floor(In / _Pixel / _Block) * _Pixel * _Block;
            if((abs(Fun_Rand(_Art).x) > _Distortion) || (abs(Fun_Rand(_Art).y) > _Distortion))
                _Art = In;
            else
                _Art = In + Fun_Rand(_Art) * 0.5 - 0.25;

                if(_Blending_Mode)
                {
                    _Result = texture2D(bckgTexture, _Art);
                    _Render.rgb = _Render_Background.rgb;
                    _Result.a = _Render_Texture.a;
                }
                else
                {
                    _Result = texture2D(imgTexture, _Art) * blendColor;
                    _Render = _Render_Texture;
                    
                }

        _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);
    gl_FragColor = _Result;
}

//@End
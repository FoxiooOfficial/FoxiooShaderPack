/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;

uniform float _PixelSize;

/************************************************************/
/* Main */
/************************************************************/

float Fun_Mod(float _X, float _Y) {
    return _X - _Y * floor(_X / _Y);
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);
    _Render_Background.a = _Render_Texture.a;

        ivec2 _Pixel = ivec2(int(In.x / fPixelWidth), int(In.y / fPixelHeight));
        
        float _PixelSizeFix = _PixelSize == 0.0 ? 0.0001 : _PixelSize;
        vec2 _Size = vec2(1.0 / fPixelWidth, 1.0 / fPixelHeight) / _PixelSizeFix;

        vec2 _UV = vec2(ceil(In.x * _Size.x) / _Size.x, ceil(In.y * _Size.y) / _Size.y);

            vec4 _Render_Texture_Ex = texture2D(imgTexture, vec2(_UV.x, _UV.y)) * blendColor;
            vec4 _Render_Background_Ex = texture2D(bckgTexture, vec2(_UV.x, _UV.y));
            _Render_Background_Ex.a = _Render_Texture.a;

                    vec4 _Result = _Blending_Mode ? _Render_Background_Ex : _Render_Texture_Ex;
                    vec4 _Render = _Blending_Mode ? _Render_Background    : _Render_Texture;

                        if (Fun_Mod(float(_Pixel.x), 3.0) == 0.0)   _Result.rgb += vec3(_Result.r, 0.0, 0.0);
                        if (Fun_Mod(float(_Pixel.x), 3.0) == 1.0)   _Result.rgb += vec3(0.0, _Result.g, 0.0);
                        else                                        _Result.rgb += vec3(0.0, 0.0, _Result.b);

        _Result = mix(_Render, _Result, _Mixing);
    gl_FragColor = _Result;
}

//@End

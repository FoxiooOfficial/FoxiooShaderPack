/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

float Fun_Mod(float _X, float _Y)
{
    return _X - _Y * floor(_X / _Y);
}

void main(void)
{
    vec2 _In = In;
    if(_Blending_Mode && _Is_Pre_296_Build)
        _In = vec2(In.x, 1.0 - In.y);

    vec4 _Render_Texture;
    vec4 _Render_Background;

    ivec2 _Pixel = ivec2(int(_In.x / fPixelWidth), int(_In.y / fPixelHeight));

            vec4 _Result = vec4(0.0);

                _Render_Texture = texture2D(imgTexture, _In + vec2(fPixelWidth, fPixelHeight))  * blendColor;
                _Render_Background = texture2D(bckgTexture, _In + vec2(fPixelWidth, fPixelHeight));
                vec4 _RenderOff2 = _Blending_Mode ? _Render_Background : _Render_Texture;

                _Render_Texture = texture2D(imgTexture, _In)  * blendColor;
                _Render_Background = texture2D(bckgTexture, _In);
                vec4 _Render = _Blending_Mode ? _Render_Background : _Render_Texture;

            /* x-axis */
            if (Fun_Mod(float(_Pixel.x), 3.0) == 0.0)   _Result.rgb = vec3(_Render.r, _RenderOff2.g, 0.0);
            if (Fun_Mod(float(_Pixel.x), 3.0) == 1.0)   _Result.rgb = vec3(0.0, _Render.g, _RenderOff2.b);
            else                                        _Result.rgb = vec3(_RenderOff2.r, 0.0, _Render.b);

            /* y-axis */
            if (Fun_Mod(float(_Pixel.y), 3.0) == 0.0)   _Result.rgb += vec3(_Render.r, _RenderOff2.g, 0.0);
            if (Fun_Mod(float(_Pixel.y), 3.0) == 1.0)   _Result.rgb += vec3(0.0, _Render.g, _RenderOff2.b);
            else                                        _Result.rgb += vec3(_RenderOff2.r, 0.0, _Render.b);

        _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);
        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _PixelSize: f32,
    parameter4_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_Mod(_X: f32, _Y: f32) -> f32 {
    return _X - _Y * floor(_X / _Y);
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);
        _Render_Background.a = _Render_Texture.a;

            var _Pixel: vec2i = vec2i(i32(input.texCoord.x / fusion.fPixelWidth), i32(input.texCoord.y / fusion.fPixelHeight));

            var _PixelSizeFix: f32 = select(params._PixelSize, 0.0001, params._PixelSize == 0.0);
            var _Size: vec2f = vec2f(1.0 / fusion.fPixelWidth, 1.0 / fusion.fPixelHeight) / _PixelSizeFix;

            var _UV: vec2f = vec2f(ceil(input.texCoord.x * _Size.x) / _Size.x, ceil(input.texCoord.y * _Size.y) / _Size.y);

                var _Render_Texture_Ex: vec4f = texture2D(img, vec2f(_UV.x, _UV.y)) * (input.color * fusion.blendColor);
                var _Render_Background_Ex: vec4f = texture2D(background, vec2f(_UV.x, _UV.y));
                _Render_Background_Ex.a = _Render_Texture.a;

                        var _Result: vec4f = select(_Render_Texture_Ex, _Render_Background_Ex, (params._Blending_Mode != 0));
                        var _Render: vec4f = select(_Render_Texture, _Render_Background, (params._Blending_Mode != 0));

                            if (Fun_Mod(f32(_Pixel.x), f32(3.0)) == 0.0) {   {
           let _fusionSwizzle0 = vec3f(_Result.r, 0.0, 0.0);
           _Result.x += _fusionSwizzle0.x;
           _Result.y += _fusionSwizzle0.y;
           _Result.z += _fusionSwizzle0.z;
       } }
                            if (Fun_Mod(f32(_Pixel.x), f32(3.0)) == 1.0) {   {
           let _fusionSwizzle1 = vec3f(0.0, _Result.g, 0.0);
           _Result.x += _fusionSwizzle1.x;
           _Result.y += _fusionSwizzle1.y;
           _Result.z += _fusionSwizzle1.z;
       } }
                            else {                                        {
                                                let _fusionSwizzle2 = vec3f(0.0, 0.0, _Result.b);
                                                _Result.x += _fusionSwizzle2.x;
                                                _Result.y += _fusionSwizzle2.y;
                                                _Result.z += _fusionSwizzle2.z;
                                            } }

            _Result = mix(_Render, _Result, params._Mixing);

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

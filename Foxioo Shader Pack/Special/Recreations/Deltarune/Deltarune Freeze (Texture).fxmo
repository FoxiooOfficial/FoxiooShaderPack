/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

uniform float _PosX;
uniform float _PosY;
uniform float fPixelWidth;
uniform float fPixelHeight;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

        float _Expanded = abs(max(_PosX, _PosY));
        vec2 _PixelPadding = vec2(_Expanded);
        vec2 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding;

    vec3 pos = vec3(_PosExpanded, 1.0);
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);

    In = In + _DirCorner * _Expanded;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
// uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform vec4 _Color;
uniform float _Fade;
uniform float _PosX;
uniform float _PosY;

/************************************************************/
/* Main */
/************************************************************/

vec4 Fun_Render(sampler2D _Tex, vec2 In, bool _Ex)
{
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0 || (_Fade < 1.0 - In.y && _Ex))
        return vec4(0.0);
    else
        return texture(_Tex, In);
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In, false) * blendColor;

    vec2 _Off = vec2(_PosX, _PosY) * vec2(fPixelWidth, fPixelHeight);
        
        vec4 _Freeze_Sum;
        _Freeze_Sum.rgb = _Color.rgb;
        _Freeze_Sum.a  = Fun_Render(imgTexture, In, true).a;
        _Freeze_Sum.a += Fun_Render(imgTexture, In - _Off, true).a * 0.5;
        _Freeze_Sum.a += Fun_Render(imgTexture, In + _Off, true).a * 0.5;
        
        _Freeze_Sum.a = clamp(_Freeze_Sum.a, 0.0, 1.0);
        _Freeze_Sum *= _Freeze_Sum.a;

           vec4 _Result = clamp(_Freeze_Sum + _Render_Texture, 0.0, 1.0);
            _Result = mix(_Render_Texture, _Result, _Mixing);
            
    fragColor = _Result;
}
//@End
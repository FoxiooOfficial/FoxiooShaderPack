/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
//uniform float _Mixing;
uniform float _PosX;
uniform float _PosY;
uniform float _OffsetX;
uniform float _OffsetY;
//uniform float _Footer;
//uniform vec4 _ColorLight;
//uniform vec4 _ColorShadow;
uniform float _Alpha;
//uniform float _Max;
//uniform float _Mul;
uniform float fPixelWidth;
uniform float fPixelHeight;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

        vec2 _Expanded = float(_Alpha > 0.0f) * abs(vec2(_OffsetX, _OffsetY)) / _PixelSize + abs(vec2(_PosX, _PosY)) / _PixelSize + vec2(64.0, 64.0) / _PixelSize;
        vec2 _PixelPadding = _Expanded;
        vec2 _PosExpanded = position;

            _PosExpanded.xy += _DirCorner * _PixelPadding;

    vec3 pos = vec3(_PosExpanded, 1.0);
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);

    In = In + _DirCorner * _Expanded;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;
//uniform sampler2D _Texture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _PosX;
uniform float _PosY;
uniform float _OffsetX;
uniform float _OffsetY;
uniform float _Footer;
uniform vec4 _ColorLight;
uniform vec4 _ColorShadow;
uniform float _Alpha;
uniform float _Max;
uniform float _Mul;

/************************************************************/
/* Main */
/************************************************************/

vec4 Fun_Render(sampler2D _Tex, vec2 In)
{
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0)
        return vec4(0.0);
    else
        return texture(_Tex, In);
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In) * blendColor;
    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);

    // shadow
    vec2 _LightPos = -(vec2(_PosX, _PosY)) * _PixelSize;
    float _Anchor = 1.0 - _Footer * _PixelSize.y;

    vec2 UV = In + vec2(_OffsetX, _OffsetY) * _PixelSize;
        UV.y = _Anchor + (_Anchor - UV.y) / _LightPos.y;
        UV.x += (UV.y - _Anchor) * _LightPos.x;

    vec4 _Render_Shadow = Fun_Render(imgTexture, UV);
    _Render_Shadow.rgb = _ColorShadow.rgb * _ColorShadow.rgb;
    _Render_Shadow.a *= _Alpha * blendColor.a;
    
    if(_LightPos.y == 0.0f)
        _Render_Shadow.a = 0.0f;

    // rim light
    vec4 _Result = _Render_Texture;

    vec2 UVRim = _LightPos;
    //const float _Max = 2.0f;
        UVRim.x = clamp(UVRim.x, -_Max * _PixelSize.x, _Max * _PixelSize.x);
        UVRim.y = clamp(UVRim.y, -_Max * _PixelSize.y, _Max * _PixelSize.y);

    UVRim *= _Mul;

    float _Render_Rim = _Render_Texture.a - (Fun_Render(imgTexture, In - UVRim * sign(_LightPos.y)).a * _LightPos.y) * blendColor.a;
        _Result.rgb = mix( _Render_Texture.rgb * _ColorShadow.rgb, 
                            _Render_Texture.rgb + _ColorLight.rgb,
                            clamp(_Render_Rim, 0.0f, 1.5f));

    // result
        _Result = mix(_Render_Shadow, _Result, _Render_Texture.a);
        _Result = mix(_Render_Texture, _Result, _Mixing);

    fragColor = _Result;
}
//@End
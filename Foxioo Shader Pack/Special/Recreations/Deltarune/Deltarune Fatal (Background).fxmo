/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

uniform float fPixelWidth;
uniform float fPixelHeight;
uniform float _Mixing;
uniform float _Mul;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);
    vec4 _Pos = vec4(position / _PixelSize, 0.0, 1.0);

        vec2 _PixelPadding = abs(_Mixing * _Mul) * _PixelSize;
        vec4 _PosExpanded = _Pos;

            _PosExpanded.xy += _DirCorner * _PixelPadding / _PixelSize;

    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * vec3(_PosExpanded.xy * _PixelSize, 1.0), 1.0);

    In = In + _DirCorner * _PixelPadding;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;

/************************************************************/
/* Main */
/************************************************************/

float Fun_PixelInside(vec2 In) {
	return float((In.x >= 0.0 && In.x <= 1.0) && (In.y >= 0.0 && In.y <= 1.0));
}

out vec4 fragColor;
void main(void)
{  
    vec2 UV = In;
    UV.y = floor((1.0 - UV.y - 0.5) * 8.0) / 8.0;
    UV.y += 0.1 + _Mixing * fPixelHeight;
    UV.y *= mix(1.0, UV.y, 0.5);

    vec2 _In = In;
    _In.x += max(UV.y * 1.5, 0.0) * -_Mixing * fPixelWidth * _Mul;

	float _Inside = Fun_PixelInside(_In);

    vec4 _Render_Border = vec4(0.0);
    vec4 _Render_Texture = texture(imgTexture, clamp(_In, 0.0, 1.0)) * blendColor;

        vec4 _Result = _Render_Texture;

        float _MixingAbs = abs(_Mixing) * fPixelWidth * 220.0;
        float _Grad = 1.0 - clamp(In.y + 1.0 - _MixingAbs / 60.0, 0.0, 1.0);

        _Result.rgb *= mix(vec3(1.0), vec3(1.0, 0.0, 0.0), _Grad * 3.0);
        _Result.a *= mix(1.0, 0.0, _Grad);

    fragColor = mix(_Render_Border, _Result, _Inside);
}
//@End
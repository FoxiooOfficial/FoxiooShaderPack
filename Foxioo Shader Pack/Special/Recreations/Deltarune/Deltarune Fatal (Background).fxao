/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

uniform float fPixelWidth;
uniform float fPixelHeight;
uniform float _Mixing;
uniform float _Mul;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
    vec4 vertexPosition = position;
    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    	vec2 _DirCorner = sign(texCoord - 0.5);

            float _Expanded = abs(_Mixing * _Mul);
            vec2 _PixelPadding = _Expanded * vec2(fPixelWidth, fPixelHeight);
            vec4 _PosExpanded = vertexPosition;

                _PosExpanded.xy += _DirCorner * _Expanded;

    	gl_Position = projectionMatrix * transformMatrix * (_PosExpanded);

    	In = texCoord + _DirCorner * _PixelPadding;
}
//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;

/************************************************************/
/* Main */
/************************************************************/

float Fun_PixelInside(vec2 In) {
	return float((In.x >= 0.0 && In.x <= 1.0) && (In.y >= 0.0 && In.y <= 1.0));
}

void main(void)
{
    vec2 UV = In;
    UV.y = floor((1.0 - UV.y - 0.5) * 8.0) / 8.0;
    UV.y += 0.1 + _Mixing * fPixelHeight;
    UV.y *= mix(1.0, UV.y, 0.5);

    vec2 _In = In;
    _In.x += max(UV.y * 1.5, 0.0) * -_Mixing * fPixelWidth * _Mul;

	float _Inside = Fun_PixelInside(_In);

    vec4 _Render_Border = vec4(0.0);
    vec4 _Render_Texture = texture2D(imgTexture, clamp(_In, 0.0, 1.0)) * blendColor;

        vec4 _Result = _Render_Texture;

        float _MixingAbs = abs(_Mixing) * fPixelWidth * 220.0;
        float _Grad = 1.0 - clamp(In.y + 1.0 - _MixingAbs / 60.0, 0.0, 1.0);

        _Result.rgb *= mix(vec3(1.0), vec3(1.0, 0.0, 0.0), _Grad * 3.0);
        _Result.a *= mix(1.0, 0.0, _Grad);

    gl_FragColor = mix(_Render_Border, _Result, _Inside);
}

//@End

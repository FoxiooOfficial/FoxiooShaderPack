/* ####################################################### */

//@Begin_vertex
struct Projection {
    size: vec2f,
    scale: vec2f,
};

@group(0) @binding(0) var<uniform> projection: Projection;

struct VertexInput {
    @location(0) position: vec2f,
    @location(1) texCoord: vec2f,
    @location(2) color: vec4f,
    @location(3) ink: f32,
    @location(4) bgCoord: vec2f,
};

struct VertexOutput {
    @builtin(position) position: vec4f,
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
    @location(2) ink: f32,
    @location(3) bgCoord: vec2f,
};

//uniform float _Mixing;

struct Params {
    parameter0_value: i32,
    _Mixing: f32,
    _PosX: f32,
    _PosY: f32,
    _OffsetX: f32,
    _OffsetY: f32,
    _Footer: f32,
    _ColorLight: vec4f,
    _ColorShadow: vec4f,
    _Alpha: f32,
    _Max: f32,
    _Mul: f32,
    parameter12_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

//uniform float _Footer;
//uniform vec4 _ColorLight;
//uniform vec4 _ColorShadow;

//uniform float _Max;
//uniform float _Mul;

@vertex fn vs_main(input: VertexInput) -> VertexOutput {
    var output: VertexOutput;
    var Pos: vec3f = vec3f(input.position, 1.0);
        output.texCoord = (fusion.textureMatrix * Pos).xy;

        var _PixelSize: vec2f = vec2f(fusion.fPixelWidth, fusion.fPixelHeight);
        var _DirCorner: vec2f = sign(output.texCoord - 0.5);

            var _Expanded: vec2f = f32(params._Alpha > 0.0f) * abs(vec2f(params._OffsetX, params._OffsetY)) / _PixelSize + abs(vec2f(params._PosX, params._PosY)) / _PixelSize + vec2f(64.0, 64.0) / _PixelSize;
            var _PixelPadding: vec2f = _Expanded;
            var _PosExpanded: vec2f = input.position;

                {
                    let _fusionSwizzle0 = _DirCorner * _PixelPadding;
                    _PosExpanded.x += _fusionSwizzle0.x;
                    _PosExpanded.y += _fusionSwizzle0.y;
                }

        var pos: vec3f = vec3f(_PosExpanded, 1.0);
        output.position = vec4f(fusion.projectionMatrix * fusion.transformMatrix * fusion.objectMatrix * pos, 1.0);

        output.texCoord = output.texCoord + _DirCorner * _Expanded;
    output.bgCoord = input.bgCoord;
    output.color = input.color;
    output.ink = input.ink;
    return output;
}
//@End

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return fusionDemultiply(textureSampleLevel(image, textureSampler, texCoord, 0.0));
}

//uniform sampler2D bckgTexture;
//uniform sampler2D _Texture;

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Mixing: f32,
    _PosX: f32,
    _PosY: f32,
    _OffsetX: f32,
    _OffsetY: f32,
    _Footer: f32,
    _ColorLight: vec4f,
    _ColorShadow: vec4f,
    _Alpha: f32,
    _Max: f32,
    _Mul: f32,
    parameter12_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_Render(_Tex: texture_2d<f32>, In: vec2f) -> vec4f {
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0) {
            return vec4f(0.0);
        }
        else {
            return texture2D(_Tex, In);
        }
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
// Fusion "Premultiplied alpha": fusion.premult is 1.0 when the runtime supplies rgb*a
// textures and tint and blends the result with one / one-minus-src-alpha.
fn fusionDemultiply(color: vec4f) -> vec4f {
    if (fusion.premult != 0.0 && color.a > 0.0) {
        return vec4f(color.rgb / color.a, color.a);
    }
    return color;
}

fn fusionPremultiply(color: vec4f) -> vec4f {
    if (fusion.premult != 0.0) {
        return vec4f(color.rgb * color.a, color.a);
    }
    return color;
}

fn fusionStraightMain(input: FragmentInput) -> vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = Fun_Render(img, vec2f(input.texCoord)) * (input.color * fusionDemultiply(fusion.blendColor));
        var _PixelSize: vec2f = vec2f(fusion.fPixelWidth, fusion.fPixelHeight);

        // shadow
        var _LightPos: vec2f = -(vec2f(params._PosX, params._PosY)) * _PixelSize;
        var _Anchor: f32 = 1.0 - params._Footer * _PixelSize.y;

        var UV: vec2f = input.texCoord + vec2f(params._OffsetX, params._OffsetY) * _PixelSize;
            UV.y = _Anchor + (_Anchor - UV.y) / _LightPos.y;
            UV.x += (UV.y - _Anchor) * _LightPos.x;

        var _Render_Shadow: vec4f = Fun_Render(img, UV);
        {
            let _fusionSwizzle0 = params._ColorShadow.rgb * params._ColorShadow.rgb;
            _Render_Shadow.x = _fusionSwizzle0.x;
            _Render_Shadow.y = _fusionSwizzle0.y;
            _Render_Shadow.z = _fusionSwizzle0.z;
        }
        _Render_Shadow.a *= params._Alpha * (input.color * fusionDemultiply(fusion.blendColor)).a;

        if(_LightPos.y == 0.0f) {
            _Render_Shadow.a = 0.0f;
        }

        // rim light
        var _Result: vec4f = _Render_Texture;

        var UVRim: vec2f = _LightPos;
        //const float _Max = 2.0f;
            UVRim.x = clamp(UVRim.x, -params._Max * _PixelSize.x, params._Max * _PixelSize.x);
            UVRim.y = clamp(UVRim.y, -params._Max * _PixelSize.y, params._Max * _PixelSize.y);

        UVRim *= params._Mul;

        var _Render_Rim: f32 = _Render_Texture.a - (Fun_Render(img, vec2f(input.texCoord - UVRim * sign(_LightPos.y))).a * _LightPos.y) * (input.color * fusionDemultiply(fusion.blendColor)).a;
            {
                let _fusionSwizzle1 = mix( _Render_Texture.rgb * params._ColorShadow.rgb,
                                _Render_Texture.rgb + params._ColorLight.rgb,
                                clamp(_Render_Rim, 0.0f, 1.5f));
                _Result.x = _fusionSwizzle1.x;
                _Result.y = _fusionSwizzle1.y;
                _Result.z = _fusionSwizzle1.z;
            }

        // result
            _Result = mix(_Render_Shadow, _Result, _Render_Texture.a);
            _Result = mix(_Render_Texture, _Result, params._Mixing);

        _fusionOutput = _Result;
    return _fusionOutput;
}

@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionStraight0 = input;
    _fusionStraight0.color = fusionDemultiply(_fusionStraight0.color);
    return fusionPremultiply(fusionStraightMain(_fusionStraight0));
}
//@End

/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform bool _Blending_Mode;
uniform float _Size;
uniform float _Mixing;

/************************************************************/
/* Main */
/************************************************************/

vec3 Fun_Sharp(sampler2D _Sampler, vec2 In, vec3 _Render, vec2 _Off)
{
    _Render = 9.0 * _Render - (
        texture2D(_Sampler, In + vec2(+_Off.x, +_Off.y)).rgb +
        texture2D(_Sampler, In + vec2(-_Off.x, -_Off.y)).rgb +
        texture2D(_Sampler, In + vec2(+_Off.x, -_Off.y)).rgb +
        texture2D(_Sampler, In + vec2(-_Off.x, +_Off.y)).rgb +
        texture2D(_Sampler, In + vec2(-_Off.x, 0.0)).rgb +
        texture2D(_Sampler, In + vec2(+_Off.x, 0.0)).rgb +
        texture2D(_Sampler, In + vec2(0.0, -_Off.y)).rgb +
        texture2D(_Sampler, In + vec2(0.0, +_Off.y)).rgb
    );

    return _Render;
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result, _Render;
        vec2 _Offset = _Size * vec2(fPixelWidth, fPixelHeight);

            if(!_Blending_Mode)
            {
                _Result.rgb = _Render_Texture.rgb;
                _Render.rgb = Fun_Sharp(imgTexture, In, _Result.rgb, _Offset) * blendColor.rgb;
            }
            else
            {
                _Result.rgb = _Render_Background.rgb;
                _Render.rgb = Fun_Sharp(bckgTexture, In, _Result.rgb, _Offset);

            }

        _Result.rgb = mix(_Result.rgb, _Render.rgb, _Mixing);
        _Result.a = _Render_Texture.a;


    gl_FragColor = _Result;
}

//@End
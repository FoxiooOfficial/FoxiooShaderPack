/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _Size: f32,
    parameter4_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/

var<private> _OverlayTop: vec4f = vec4f(0.55, 0.6, 0.39, 1.0);
var<private> _OverlayBottom: vec4f = vec4f(0.35, 0.4, 0.29, 1.0);

var<private> _InnerLight: vec3f = vec3f(0.91, 0.96, 0.75);
var<private> _InnerShadow: vec3f = vec3f(0.55, 0.58, 0.43);
fn Fun_Luminance(_Result: vec4f) -> f32 {
    const _Kr: f32 = 0.299;
        const _Kg: f32 = 0.587;
        const _Kb: f32 = 0.114;

        var _Y: f32 = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

        return _Y * _Result.a;
}

fn Fun_Border(_Sampler: texture_2d<f32>, In: vec2f, _Off: vec2f, _Render: vec4f, _Tint: vec4f) -> vec4f {
    var _Up: f32 = Fun_Luminance(vec4f(_Tint * texture2D(_Sampler, In + vec2f(0.0, _Off.y)))) * 1.75;
        var _Down: f32 = Fun_Luminance(vec4f(_Tint * texture2D(_Sampler, In + vec2f(0.0, -_Off.y)))) * 1.75;
        var _Left: f32 = Fun_Luminance(vec4f(_Tint * texture2D(_Sampler, In + vec2f(_Off.x, 0.0)))) * 1.75;
        var _Right: f32 = Fun_Luminance(vec4f(_Tint * texture2D(_Sampler, In + vec2f(-_Off.x, 0.0)))) * 1.75;

            var _Glow: f32 = _Render.a - _Up;
            var _Shadow: f32 = (_Render.a * 3.0) - (_Down + _Left + _Right);

        var _Result: vec4f = vec4f(0.0);
        _Result = mix(_Result, _OverlayTop, _Glow);
        _Result = mix(_Result, _OverlayBottom, _Shadow);

        return _Result;
}

fn Fun_Sharp(_Sampler: texture_2d<f32>, In: vec2f, _Off: vec2f, _Tint: vec4f) -> vec3f {
    var _Emboss: vec2f;

        var _NW: vec4f = _Tint * texture2D(_Sampler, In + vec2f(-_Off.x, -_Off.y));
        var _N: vec4f = _Tint * texture2D(_Sampler, In + vec2f(0.0, -_Off.y));
        var _NE: vec4f = _Tint * texture2D(_Sampler, In + vec2f(_Off.x, -_Off.y));
        var _W: vec4f = _Tint * texture2D(_Sampler, In + vec2f(-_Off.x, 0.0));
        //vec4 _C  = _Tint * texture(_Sampler, In);
        var _E: vec4f = _Tint * texture2D(_Sampler, In + vec2f(_Off.x, 0.0));
        var _SW: vec4f = _Tint * texture2D(_Sampler, In + vec2f(-_Off.x, _Off.y));
        var _S: vec4f = _Tint * texture2D(_Sampler, In + vec2f(0.0, _Off.y));
        var _SE: vec4f = _Tint * texture2D(_Sampler, In + vec2f(_Off.x, _Off.y));

            _Emboss.x = (Fun_Luminance(_NE) + 2.0 * Fun_Luminance(_E) + Fun_Luminance(_SE)) - (Fun_Luminance(_NW) + 2.0 * Fun_Luminance(_W) + Fun_Luminance(_SW));
            _Emboss.y = (Fun_Luminance(_SW) + 2.0 * Fun_Luminance(_S) + Fun_Luminance(_SE)) - (Fun_Luminance(_NW) + 2.0 * Fun_Luminance(_N) + Fun_Luminance(_NE));
            _Emboss.y = -_Emboss.y;

        var _Render: vec3f = normalize(vec3f(_Emboss.x, _Emboss.y, 0.35));
        _Render = _Render * 0.5 + 0.5;

        return _Render;
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Result: vec4f;
            var _Render: vec4f;
            var _Alpha: f32;
            var _Offset: vec2f = params._Size * -vec2f(fusion.fPixelWidth, fusion.fPixelHeight);

                if(!(params._Blending_Mode != 0))
                {
                    _Result = _Render_Texture;
                    _Render = Fun_Border(img, vec2f(input.texCoord), _Offset, _Render_Texture, vec4f((input.color * fusion.blendColor)));

                    var _Sharp: vec3f = vec3f(Fun_Sharp(img, vec2f(input.texCoord), _Offset, vec4f((input.color * fusion.blendColor))));
                    _Alpha = Fun_Luminance(vec4f(_Sharp.r, _Sharp.g, _Sharp.b, _Render_Texture.a));
                }
                else
                {
                    {
                        let _fusionSwizzle0 = _Render_Background.rgb;
                        _Result.x = _fusionSwizzle0.x;
                        _Result.y = _fusionSwizzle0.y;
                        _Result.z = _fusionSwizzle0.z;
                    }
                    _Result.a = _Render_Texture.a;

                    _Render = Fun_Border(background, vec2f(input.texCoord), _Offset, _Render_Background, vec4f(1.0));

                    var _Sharp: vec3f = vec3f(Fun_Sharp(background, vec2f(input.texCoord), _Offset, vec4f(1.0)));
                    _Alpha = Fun_Luminance(vec4f(_Sharp.r, _Sharp.g, _Sharp.b, _Render_Texture.a));
                }

                    var _InnerMask: f32 = clamp((_Alpha * _Alpha) * 2.0, 0.0, 1.0) * 0.85;
                    var _InnerColor: vec3f = mix(_InnerShadow, _InnerLight, _InnerMask);

                    _InnerColor += (_InnerColor * (abs(input.texCoord.y * 1.3 - 0.75) * _InnerLight)) * 0.25;
                    _InnerColor -= pow(abs(input.texCoord.x * 2.0 - 1.0), 3.0) * 0.5 * _InnerShadow;

                {
                    let _fusionSwizzle1 = mix(_InnerColor, _Render.rgb, _Render.a / 18.0);
                    _Render.x = _fusionSwizzle1.x;
                    _Render.y = _fusionSwizzle1.y;
                    _Render.z = _fusionSwizzle1.z;
                }

            {
                let _fusionSwizzle2 = mix(_Result.rgb, _Render.rgb, params._Mixing);
                _Result.x = _fusionSwizzle2.x;
                _Result.y = _fusionSwizzle2.y;
                _Result.z = _fusionSwizzle2.z;
            }

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

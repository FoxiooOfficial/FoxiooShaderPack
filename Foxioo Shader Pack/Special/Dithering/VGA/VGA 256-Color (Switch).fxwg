//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _DitheringSize: f32,
    _Add: f32,
    _Mul: f32,
    parameter6_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/

const _Dither: array<f32, 16> = array<f32, 16>(
    0.0 / 16.0,  8.0 / 16.0,  2.0 / 16.0, 10.0 / 16.0,
   12.0 / 16.0,  4.0 / 16.0, 14.0 / 16.0,  6.0 / 16.0,
    3.0 / 16.0, 11.0 / 16.0,  1.0 / 16.0,  9.0 / 16.0,
   15.0 / 16.0,  7.0 / 16.0, 13.0 / 16.0,  5.0 / 16.0
);

// https://gist.github.com/cesarmiquel/1780ab6078b9735371d1f10a9d60d233
var<private> _Level_Lum: array<f32, 3>;
var<private> _Level_Sat: array<f32, 3>;
fn Fun_Trunc(_Value: f32) -> f32 {
    return sign(_Value) * floor(abs(_Value));
}

fn Fun_Trunc_2(_Value: vec2f) -> vec2f {
    return sign(_Value) * floor(abs(_Value));
}

fn Fun_FMod(_Value: f32, _Denom: f32) -> f32 {
    return _Value - _Denom * Fun_Trunc(f32(_Value / _Denom));
}

fn Fun_FMod_2(_Value: vec2f, _Denom: vec2f) -> vec2f {
    return _Value - _Denom * Fun_Trunc_2(vec2f(_Value / _Denom));
}

fn Fun_Quant(_Level: f32, _Color: vec3f, _Out: ptr<function, i32>) -> f32 {
    var _Diff: vec3f = abs(_Level - _Color);

        if(_Diff.x <= _Diff.y && _Diff.x <= _Diff.z)
        {
            (*_Out) = 0;
            return _Color.x;
        }
        else if(_Diff.y <= _Diff.x && _Diff.y <= _Diff.z)
        {
            (*_Out) = 1;
            return _Color.y;
        }
        else
        {
            (*_Out) = 2;
            return _Color.z;
        }
}

fn Fun_Convert(_Color: vec3f) -> vec3f {
    _Level_Lum[0] = 1.0;
        _Level_Lum[1] = 27.909 / 63.0;
        _Level_Lum[2] = 16.002 / 63.0;

        _Level_Sat[0] = 0.0;
        _Level_Sat[1] = 0.5;
        _Level_Sat[2] = 5.0 / 7.0;

        var _V: f32 = max(_Color.r, max(_Color.g, _Color.b));
        var _Min: f32 = min(_Color.r, min(_Color.g, _Color.b));
        var _Diff: f32 = _V - _Min;

        var _Sat: f32 = select(0.0, _Diff / _V, _V > 0.001);

        // gray map
        if(_Sat < 0.06 || _V < 0.02) {
            return floor(_Color * 15.0 + 0.5) / 15.0;
        }

            var _V_In: i32;
            var _V_High: f32 = Fun_Quant(f32(_V), vec3f(_Level_Lum[0], _Level_Lum[1], _Level_Lum[2]), &_V_In);

            var _S_In: i32;
            var _Sat_High: f32 = Fun_Quant(f32(_Sat), vec3f(_Level_Sat[0], _Level_Sat[1], _Level_Sat[2]), &_S_In);

                var _Low: f32 = _V_High * (1.0 - _Sat_High);

        var _Hue: f32;
        if(_V == _Color.r) {      _Hue = 60.0 * Fun_FMod(f32((_Color.g - _Color.b) / _Diff), f32(6.0)); }
        else if(_V == _Color.g) { _Hue = 60.0 * ((_Color.b - _Color.r) / _Diff + 2.0); }
        else {                    _Hue = 60.0 * ((_Color.r - _Color.g) / _Diff + 4.0); }

            if(_Hue < 0.0) { _Hue += 360.0; }

        var _Sec: f32 = _Hue / 60.0;
        var _Step: i32 = i32(floor(_Sec));
        var _Angle: f32 = floor((_Sec - f32(_Step)) * 4.0) / 4.0;
        var _Vviv: f32;

            if (((f32(_Step)) - (2.0) * floor((f32(_Step)) / (2.0))) == 0.0) {
                _Vviv = mix(_Low, _V_High, _Angle);
            }
            else {
                _Vviv = mix(_V_High, _Low, _Angle);
            }

            if     (_Step == i32(0)) { return vec3f(_V_High, _Vviv, _Low); }
            else if(_Step == i32(1)) { return vec3f(_Vviv, _V_High, _Low); }
            else if(_Step == i32(2)) { return vec3f(_Low, _V_High, _Vviv); }
            else if(_Step == i32(3)) { return vec3f(_Low, _Vviv, _V_High); }
            else if(_Step == i32(4)) { return vec3f(_Vviv, _Low, _V_High); }
            else if(_Step == i32(5)) { return vec3f(_V_High, _Low, _Vviv); }
            else {                return vec3f(0.0); }
}

fn Fun_Dithering(_Index: i32) -> f32 {
    return _Dither[_Index];
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

        {
            let _fusionSwizzle0 = _Render_Texture.rgb * params._Mul + params._Add;
            _Render_Texture.x = _fusionSwizzle0.x;
            _Render_Texture.y = _fusionSwizzle0.y;
            _Render_Texture.z = _fusionSwizzle0.z;
        }
        {
            let _fusionSwizzle1 = _Render_Background.rgb * params._Mul + params._Add;
            _Render_Background.x = _fusionSwizzle1.x;
            _Render_Background.y = _fusionSwizzle1.y;
            _Render_Background.z = _fusionSwizzle1.z;
        }

            var _Result: vec4f;
            var _Render: vec4f;

            if(!(params._Blending_Mode != 0))
            {
                _Result = _Render_Texture;
                _Render = _Render_Texture;
            }
            else
            {
                {
                    let _fusionSwizzle2 = _Render_Background.rgb;
                    _Result.x = _fusionSwizzle2.x;
                    _Result.y = _fusionSwizzle2.y;
                    _Result.z = _fusionSwizzle2.z;
                }
                _Result.a = _Render_Texture.a;

                _Render = _Render_Background;
            }

            var _Dith: vec2f = vec2f(Fun_FMod_2(vec2f(input.texCoord / vec2f(fusion.fPixelWidth, fusion.fPixelHeight)), vec2f(4.0)));

            var _Index: i32 = i32(_Dith.x) + i32(_Dith.y) * 4;
            var _DithValue: f32 = Fun_Dithering(i32(_Index));

             var _Color: vec3f = _Result.rgb + (_DithValue - 0.5) * params._DitheringSize;

                _Color = clamp(_Color, vec3f(0.0), vec3f(1.0));

            {
                let _fusionSwizzle3 = Fun_Convert(_Color);
                _Result.x = _fusionSwizzle3.x;
                _Result.y = _fusionSwizzle3.y;
                _Result.z = _fusionSwizzle3.z;
            }
            {
                let _fusionSwizzle4 = mix(_Render.rgb, _Result.rgb, params._Mixing);
                _Result.x = _fusionSwizzle4.x;
                _Result.y = _fusionSwizzle4.y;
                _Result.z = _fusionSwizzle4.z;
            }

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

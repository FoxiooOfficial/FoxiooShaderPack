/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;
uniform float _DitheringSize;

uniform float _Add;
uniform float _Mul;

/************************************************************/
/* Main */
/************************************************************/

const float _Dither[16] = float[]
(
    0.0 / 16.0,  8.0 / 16.0,  2.0 / 16.0, 10.0 / 16.0,
   12.0 / 16.0,  4.0 / 16.0, 14.0 / 16.0,  6.0 / 16.0,
    3.0 / 16.0, 11.0 / 16.0,  1.0 / 16.0,  9.0 / 16.0,
   15.0 / 16.0,  7.0 / 16.0, 13.0 / 16.0,  5.0 / 16.0
);

float Fun_Trunc(float _Value) {
    return sign(_Value) * floor(abs(_Value));
}

vec2 Fun_Trunc(vec2 _Value) {
    return sign(_Value) * floor(abs(_Value));
}

float Fun_FMod(float _Value, float _Denom) {
    return _Value - _Denom * Fun_Trunc(_Value / _Denom);
}

vec2 Fun_FMod(vec2 _Value, vec2 _Denom) {
    return _Value - _Denom * Fun_Trunc(_Value / _Denom);
}

// https://gist.github.com/cesarmiquel/1780ab6078b9735371d1f10a9d60d233
float _Level_Lum[3];
float _Level_Sat[3];

float Fun_Quant(float _Level, vec3 _Color, out int _Out)
{
    vec3 _Diff = abs(_Level - _Color);

    if(_Diff.x <= _Diff.y && _Diff.x <= _Diff.z)
    {
        _Out = 0;
        return _Color.x;
    }
    else if(_Diff.y <= _Diff.x && _Diff.y <= _Diff.z)
    {
        _Out = 1;
        return _Color.y;
    }
    else
    {
        _Out = 2;
        return _Color.z;
    }
}

vec3 Fun_Convert(vec3 _Color)
{
    _Level_Lum[0] = 1.0;
    _Level_Lum[1] = 27.909 / 63.0;
    _Level_Lum[2] = 16.002 / 63.0;

    _Level_Sat[0] = 0.0;
    _Level_Sat[1] = 0.5;
    _Level_Sat[2] = 5.0 / 7.0;

    float _V = max(_Color.r, max(_Color.g, _Color.b));
    float _Min = min(_Color.r, min(_Color.g, _Color.b));
    float _Diff = _V - _Min;

    float _Sat = _V > 0.001 ? _Diff / _V : 0.0;

    // gray map
    if(_Sat < 0.06 || _V < 0.02)
        return floor(_Color * 15.0 + 0.5) / 15.0;

        int _V_In;
        float _V_High = Fun_Quant(_V, vec3(_Level_Lum[0], _Level_Lum[1], _Level_Lum[2]), _V_In);

        int _S_In;
        float _Sat_High = Fun_Quant(_Sat, vec3(_Level_Sat[0], _Level_Sat[1], _Level_Sat[2]), _S_In);

            float _Low = _V_High * (1.0 - _Sat_High);

    float _Hue;
    if(_V == _Color.r)      _Hue = 60.0 * Fun_FMod((_Color.g - _Color.b) / _Diff, 6.0);
    else if(_V == _Color.g) _Hue = 60.0 * ((_Color.b - _Color.r) / _Diff + 2.0);
    else                    _Hue = 60.0 * ((_Color.r - _Color.g) / _Diff + 4.0);

        if(_Hue < 0.0) _Hue += 360.0;

    float _Sec = _Hue / 60.0;
    int _Step = int(floor(_Sec));
    float _Angle = floor((_Sec - float(_Step)) * 4.0) / 4.0;
    float _Vviv;

        if (mod(float(_Step), 2.0) == 0.0)
            _Vviv = mix(_Low, _V_High, _Angle);
        else
            _Vviv = mix(_V_High, _Low, _Angle);

        if     (_Step == 0) return vec3(_V_High, _Vviv, _Low);
        else if(_Step == 1) return vec3(_Vviv, _V_High, _Low);
        else if(_Step == 2) return vec3(_Low, _V_High, _Vviv);
        else if(_Step == 3) return vec3(_Low, _Vviv, _V_High);
        else if(_Step == 4) return vec3(_Vviv, _Low, _V_High);
        else if(_Step == 5) return vec3(_V_High, _Low, _Vviv); 
        else                return vec3(0.0);
}

float Fun_Dithering(int _Index) {
    return _Dither[_Index];
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = texture(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture(bckgTexture, In);

    _Render_Texture.rgb = _Render_Texture.rgb * _Mul + _Add;
    _Render_Background.rgb = _Render_Background.rgb * _Mul + _Add;

        vec4 _Result, _Render;

        if(!_Blending_Mode)
        {
            _Result = _Render_Texture;
            _Render = _Render_Texture;
        }
        else
        {
            _Result.rgb = _Render_Background.rgb;
            _Result.a = _Render_Texture.a;
            
            _Render = _Render_Background;
        }

        vec2 _Dith = vec2(Fun_FMod(In / vec2(fPixelWidth, fPixelHeight), vec2(4.0)));

        int _Index = int(_Dith.x) + int(_Dith.y) * 4;
        float _DithValue = Fun_Dithering(_Index);

         vec3 _Color = _Result.rgb + (_DithValue - 0.5) * _DitheringSize;
            
            _Color = clamp(_Color, 0.0, 1.0);

        _Result.rgb = Fun_Convert(_Color);
        _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);

    fragColor = _Result;
}
//@End
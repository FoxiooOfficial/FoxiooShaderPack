/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _Size: f32,
    _Quality: i32,
    parameter5_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_Filter(_Sampler: texture_2d<f32>, In: vec2f, _Render: vec3f, _Tint: vec4f) -> vec3f {
    var _Result: vec3f = _Render;

        var _Center: f32 = (f32(params._Quality) - 1.0) / 2.0;
        var _SizePixel: vec2f = params._Size * vec2f(fusion.fPixelWidth, fusion.fPixelHeight) / f32(params._Quality);

        var x: i32; var y: i32;
        for(y = i32(0); y < params._Quality; y += 1)
        {
            for(x = i32(0); x < params._Quality; x += 1)
            {
                var xx: f32 = f32(x) - _Center;
                var yy: f32 = f32(y) - _Center;

                var UV: vec2f = In + vec2f(xx, yy) * _SizePixel;

                _Result = min(_Result.rgb, texture2D(_Sampler, UV).rgb * _Tint.rgb);
            }
        }

        return _Result;
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Result: vec4f = select(_Render_Texture, _Render_Background, (params._Blending_Mode != 0));
            var _Filter: vec3f = select(Fun_Filter(img, vec2f(input.texCoord), vec3f(_Render_Texture.rgb), vec4f((input.color * fusion.blendColor))), Fun_Filter(background, vec2f(input.texCoord), vec3f(_Render_Background.rgb), vec4f(1.0)), (params._Blending_Mode != 0));

            {
                let _fusionSwizzle0 = mix(_Result.rgb, _Filter, params._Mixing);
                _Result.x = _fusionSwizzle0.x;
                _Result.y = _fusionSwizzle0.y;
                _Result.z = _fusionSwizzle0.z;
            }
            _Result.a = _Render_Texture.a;

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

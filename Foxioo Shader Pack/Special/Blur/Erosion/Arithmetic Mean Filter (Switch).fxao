/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Size;
uniform bool _Blending_Mode;
uniform int _Quality;

/************************************************************/
/* Main */
/************************************************************/

/*  Special thanks to Envy24!
    https://www.shadertoy.com/view/ssySDh */

vec3 Fun_Filter(sampler2D _Sampler, vec2 In)
{
    vec3 _Result = vec3(0.0);

    float _Center = (float(_Quality) - 1.0) / 2.0;
    vec2 _SizePixel = _Size * vec2(fPixelWidth,  fPixelHeight) / float(_Quality);
    
    float _Sum = float(_Quality * _Quality);

    for(int y = 0; y < _Quality; y++)
    {  
        for(int x = 0; x < _Quality; x++)
        {  
            float xx = float(x) - _Center;
            float yy = float(y) - _Center;

            vec2 UV = In + vec2(xx, yy) * _SizePixel;

            vec3 _Effect = texture2D(_Sampler, UV).rgb;
            
            _Result += _Effect;
            //_Sum++;
        }
    }

    return _Result / _Sum;
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec3 _Filter = _Blending_Mode   ? Fun_Filter(bckgTexture, In)
                                        : Fun_Filter(imgTexture, In);

        _Result.rgb = mix(_Result.rgb, _Filter, _Mixing);
        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

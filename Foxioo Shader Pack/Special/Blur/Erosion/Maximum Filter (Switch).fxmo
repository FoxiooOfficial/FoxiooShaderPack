/***********************************************************/

/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH) || defined(GL_OES_standard_derivatives)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform float _Size;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

const int _Offset = 8;

vec3 Fun_Filter(sampler2D _Sampler, vec2 In, vec3 _Render)
{
    vec3 _Result = _Render;

    for(int y = -_Offset; y <= _Offset; y++)
    {
        for(int x = -_Offset; x <= _Offset; x++)
        {
            _Result.rgb = max(_Result.rgb, texture(_Sampler, In + (vec2(x, y) / float(_Offset)) * vec2(fPixelWidth, fPixelHeight) * _Size).rgb);
        }
    }

    return _Result;
}

out vec4 fragColor;
void main(void)
{
    vec2 _In = In;
    if(_Blending_Mode && _Is_Pre_296_Build)
        _In = vec2(In.x, 1.0 - In.y);

    vec4 _Render_Texture = texture(imgTexture, _In) * blendColor;
    vec4 _Render_Background =texture(bckgTexture, _In);

        vec4 _Result = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec3 _Filter = _Blending_Mode ? Fun_Filter(bckgTexture, _In, _Render_Background.rgb) : Fun_Filter(imgTexture, _In, _Render_Texture.rgb) * blendColor.rgb;
    
        _Result.rgb = mix(_Result.rgb, _Filter, _Mixing);
        _Result.a = _Render_Texture.a;

    fragColor = _Result;
}
//@End
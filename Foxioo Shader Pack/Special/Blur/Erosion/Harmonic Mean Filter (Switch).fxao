/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform float _Size;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

const int _Offset = 8;

/*  Special thanks to Envy24!
    https://www.shadertoy.com/view/ssySDh */

vec3 Fun_Filter(sampler2D _Sampler, vec2 In)
{
    vec3 _Result = vec3(1.0);
    float _Sum = (2.0 * float(_Offset) + 1.0) * (2.0 * float(_Offset) + 1.0);

    for(int y = -_Offset; y <= _Offset; y++)
    {
        for(int x = -_Offset; x <= _Offset; x++)
        {
            vec3 _Render = texture2D(_Sampler, In + (vec2(x, y) / float(_Offset)) * vec2(fPixelWidth, fPixelHeight) * _Size).rgb;
           
            _Result += 1.0 / _Render;
            //_Sum++;
        }
    }

    return _Sum / _Result;
}

void main(void)
{
    vec2 _In = In;
    if(_Blending_Mode && _Is_Pre_296_Build)
        _In = vec2(In.x, 1.0 - In.y);

    vec4 _Render_Texture = texture2D(imgTexture, _In) * blendColor;
    vec4 _Render_Background =texture2D(bckgTexture, _In);

        vec4 _Result = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec3 _Filter = _Blending_Mode ? Fun_Filter(bckgTexture, _In) : Fun_Filter(imgTexture, _In) * blendColor.rgb;
    
        _Result.rgb = mix(_Result.rgb, _Filter, _Mixing);
        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

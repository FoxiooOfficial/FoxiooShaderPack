/***********************************************************/

/* Shader author: Foxioo */
/* Version shader: 1.5 (18.10.2025) */
/* My GitHub: https://github.com/FoxiooOfficial */

/***********************************************************/

/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

const float _Off = 1.0;

float Fun_Luminance(vec4 _Result)
{
    const float _Kr = 0.299;
    const float _Kg = 0.587;
    const float _Kb = 0.114;

    float _Y = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

    return _Y * _Result.a;
}

vec4 Fun_AA(sampler2D _Sampler, vec2 In, vec4 _Render, float _Alpha)
{
    vec2 _Size = vec2(fPixelWidth, fPixelHeight);

    /* kinda emboss
        NE -> 45*    (+X, +Y);
        SE -> 135*   (-X, +Y);
        SW -> 225*   (+X, -Y);
        NW -> 315*   (-X, -Y);

        based on FXAA
        this helps: https://catlikecoding.com/unity/tutorials/custom-srp/fxaa/ :3
    */
    vec4 _NW = texture(_Sampler, In + vec2(-_Off, -_Off) * _Size);
    vec4 _NE = texture(_Sampler, In + vec2( _Off, -_Off) * _Size);
    vec4 _SW = texture(_Sampler, In + vec2(-_Off,  _Off) * _Size);
    vec4 _SE = texture(_Sampler, In + vec2( _Off,  _Off) * _Size);

        /* give me luminance!!! */
        float _LumNW = Fun_Luminance(_NW);
        float _LumNE = Fun_Luminance(_NE);
        float _LumSW = Fun_Luminance(_SW);
        float _LumSE = Fun_Luminance(_SE);
        float _LumM  = Fun_Luminance(_Render);

        /* offset 
            dir -> difference between the x and y offsets
        */
        vec2 _Dir = vec2(  -((_LumNW + _LumNE) - (_LumSW + _LumSE)),
                                ((_LumNW + _LumSW) - (_LumNE + _LumSE))
                            );

        float _DirNorm = max((_LumNW + _LumNE + _LumSW + _LumSE) / 32.0, 1.0 / 128.0);
        float _DirInv = 1.0 / (min(abs(_Dir.x), abs(_Dir.y)) + _DirNorm);
    
            _Dir = clamp(_Dir * _DirInv, vec2(-8.0, -8.0), vec2(8.0, 8.0)) * _Size;

        vec4 _Result = _Render * 0.5;
        vec4 _ClearType = vec4(0.0);
        vec4 _SampleSum = vec4(0.0);
    
        /* super cleantype colors! */
        const vec4 _M  = vec4(1.0, 0.31, 0.08, 1.0);    /* left -> orange */
        const vec4 _P  = vec4(0.16, 0.58, 1.0, 1.0);    /* right -> blue */

            for(int i = 0; i < 4; i++)
            {
                float _Offset = (float(i) / 3.0 - 0.5);
                vec4 _Sample = texture(_Sampler, In + _Dir * _Offset * _Mixing);
                
                vec4 _Mul = (mix(_P, _M, clamp((_Dir.y / _Size.y), -1.0, 1.0)));
                
                _Result += _Sample * 0.25;
                _ClearType += _Sample * _Mul;
                _SampleSum += _Sample;
            }

            _SampleSum /= 4.0;
            _ClearType /= 4.0;

            _ClearType = mix(_ClearType, _Render, _SampleSum.r * _SampleSum.g * _SampleSum.b * _SampleSum.a);
    
    return mix(_Render, _ClearType, _Mixing) * _Alpha;
}

out vec4 fragColor;
void main(void)
{
    vec2 _In = In;
    if(_Blending_Mode && _Is_Pre_296_Build)
        _In = vec2(In.x, 1.0 - In.y);

    vec4 _Render_Texture = texture(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture(bckgTexture, _In);

        vec4 _Render = _Blending_Mode ? Fun_AA(bckgTexture, _In, _Render_Background, _Render_Texture.a) : Fun_AA(imgTexture, In, _Render_Texture, 1.0) * blendColor;

    fragColor = _Render;
}
//@End
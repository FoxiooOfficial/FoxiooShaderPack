//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _Threshold: f32,
    _Relative: f32,
    _Off: f32,
    parameter6_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

//uniform float _SubPixelBlending;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_ShouldProcess(_Range: f32, _MaxLum: f32) -> f32 {
    var _ActualThreshold: f32 = max(params._Threshold, params._Relative * _MaxLum);
        return f32(_Range >= _ActualThreshold);
}

fn Fun_Luminance(_Result: vec4f) -> f32 {
    const _Kr: f32 = 0.299;
        const _Kg: f32 = 0.587;
        const _Kb: f32 = 0.114;

        var _Y: f32 = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

        return sqrt(_Y) * _Result.a;
}

fn Fun_AA(_Sampler: texture_2d<f32>, In: vec2f, _Render: vec4f, _Alpha: f32) -> vec4f {
    var _Size: vec2f = vec2f(fusion.fPixelWidth, fusion.fPixelHeight);

        /* kinda emboss

            based on FXAA
            this helps: https://catlikecoding.com/unity/tutorials/custom-srp/fxaa/ :3
        */
        var _N: vec4f = texture2D(_Sampler, In + vec2f(0.0, params._Off) * _Size);
        var _E: vec4f = texture2D(_Sampler, In + vec2f(params._Off, 0.0) * _Size);
        var _S: vec4f = texture2D(_Sampler, In + vec2f(0.0, -params._Off) * _Size);
        var _W: vec4f = texture2D(_Sampler, In + vec2f(-params._Off, 0.0) * _Size);

        var _NW: vec4f = texture2D(_Sampler, In + vec2f(-params._Off, params._Off) * _Size);
        var _NE: vec4f = texture2D(_Sampler, In + vec2f(params._Off, params._Off) * _Size);
        var _SW: vec4f = texture2D(_Sampler, In + vec2f(-params._Off, -params._Off) * _Size);
        var _SE: vec4f = texture2D(_Sampler, In + vec2f(params._Off, -params._Off) * _Size);

            /* give me luminance!!! */
            var _LumN: f32 = Fun_Luminance(_N);
            var _LumE: f32 = Fun_Luminance(_E);
            var _LumS: f32 = Fun_Luminance(_S);
            var _LumW: f32 = Fun_Luminance(_W);

            var _LumNW: f32 = Fun_Luminance(_NW);
            var _LumNE: f32 = Fun_Luminance(_NE);
            var _LumSW: f32 = Fun_Luminance(_SW);
            var _LumSE: f32 = Fun_Luminance(_SE);

            var _LumM: f32 = Fun_Luminance(_Render);

            /* high and low */
            var _High: f32 = max(max(max(max(_LumM, _LumN), _LumE), _LumS), _LumW);
                    _High = max(_High, max(max(_LumNW, _LumNE), max(_LumSW, _LumSE)));

            var _Low: f32 = min(min(min(min(_LumM, _LumN), _LumE), _LumS), _LumW);
                    _Low = min(_Low, min(min(_LumNW, _LumNE), min(_LumSW, _LumSE)));

                var _Range: f32 = _High - _Low;
                var _Mul: f32 = Fun_ShouldProcess(f32(_Range), f32(_High));

                var _Horizontal: f32 = abs(_LumN + _LumS - 2.0 * _LumM) * 2.0 +
                        abs(_LumNW + _LumSW - 2.0 * _LumW) +
                        abs(_LumNE + _LumSE - 2.0 * _LumE);

                var _Vertical: f32 = abs(_LumE + _LumW - 2.0 * _LumM) * 2.0 +
                    abs(_LumNE + _LumNW - 2.0 * _LumN) +
                    abs(_LumSE + _LumSW - 2.0 * _LumS);

                var _IsHorizontal: bool = _Horizontal >= _Vertical;

                    var _L1: f32 = select(_LumE, _LumN, _IsHorizontal);
                    var _L2: f32 = select(_LumW, _LumS, _IsHorizontal);

                    var _G1: f32 = abs(_L1 - _LumM);
                    var _G2: f32 = abs(_L2 - _LumM);

                    var _PixelOffset: f32 = select(_Size.x, _Size.y, _IsHorizontal);
                    if (_G2 > _G1) { _PixelOffset = -_PixelOffset; }

                    var _UV_Final: vec2f = In;
                    if (_IsHorizontal) { _UV_Final.y += _PixelOffset; }
                    else {               _UV_Final.x += _PixelOffset; }

                    var _SubPixel: f32 = 2.0 * (_LumN + _LumE + _LumS + _LumW);
                            _SubPixel += (_LumNW + _LumNE + _LumSW + _LumSE);
                            _SubPixel *= (1.0 / 12.0);
                            _SubPixel = abs(_SubPixel - _LumM);
                            _SubPixel = clamp(_SubPixel / _Range, 0.0, 1.0);

                    var _Factor: f32 = smoothstep(0.0, 1.0, _SubPixel);
                    _Factor *= _Factor * _Mul;

                    var _EdgeColor: vec4f = texture2D(_Sampler, _UV_Final) * 0.75 + (_S + _W + _N + _E) / 4.0 * 0.25;

        return mix(_Render, _EdgeColor, clamp(_Factor * params._Mixing, 0.0, 1.0)) * _Alpha;
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Render: vec4f = select(Fun_AA(img, vec2f(input.texCoord), _Render_Texture, f32(1.0)) * (input.color * fusion.blendColor), Fun_AA(background, vec2f(input.texCoord), _Render_Background, f32(_Render_Texture.a)), (params._Blending_Mode != 0));

        _fusionOutput = _Render;
    return _fusionOutput;
}
//@End

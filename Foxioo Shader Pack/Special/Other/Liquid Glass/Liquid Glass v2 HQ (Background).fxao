/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;
uniform float _Radius;
uniform float _Size;
uniform float _Liquid;


/************************************************************/
/* Main */
/************************************************************/


#define GOLDEN_ANGLE    2.39996323
#define PI              3.14159265359

const int SAMPLES_INNER  = 16; 
const int SAMPLES_BLUR   = 128;
const float _Sigma       = 40.0;

float Fun_Hash12(vec2 _UV)
{
    vec3 _Pos = fract(vec3(_UV.xyx) * 0.103116);
    _Pos += dot(_Pos, _Pos.yzx + 33.333);
    return fract((_Pos.x + _Pos.y) * _Pos.z);
}

vec3 Fun_Blur(vec2 UV, vec2 _Pixel)
{
    float _SigmaULTRA = 1.0 / (2.0 * _Sigma * _Sigma);

    float _Angle = Fun_Hash12(UV.xy) * 2.0 * PI;
    float _Sin, _Cos;
    //sincos(_Angle, _Sin, _Cos);
    _Sin = sin(_Angle);
    _Cos = cos(_Angle);

    vec3 _Result = vec3(0.0);
    float _Sum = 0.0;

    for(int i = 0; i < SAMPLES_BLUR; i++)
    {
        float _Rad = sqrt((float(i) + 0.5) / float(SAMPLES_BLUR)); 
        float _Thr = float(i) * GOLDEN_ANGLE;

            vec2 _Off;
            //sincos(_Thr, _Off.x, _Off.y);
            _Off.x = sin(_Thr);
            _Off.y = cos(_Thr);
            _Off *= _Rad * _Radius; 
                    
            vec2 _Rot = vec2
            (
                _Cos * _Off.x - _Sin * _Off.y,
                _Sin * _Off.x + _Cos * _Off.y
            );

        float _Weight = exp(-pow(_Rad * _Radius / 4.0, 2.0) * _SigmaULTRA);

        _Result += texture2D(bckgTexture, UV.xy + _Rot * _Pixel).rgb * _Weight;
        _Sum += _Weight;
    }

    _Result /= _Sum;
    return _Result;
}

float Fun_Inner(vec2 In, vec2 _Pixel, float _Tint)
{
    float _Alpha = 0.0, _Idx = 0.0;
    for(int y = 0; y <= SAMPLES_INNER; y++)
    {
        for(int x = 0; x <= SAMPLES_INNER; x++)
        {
            vec2 _Offset = (vec2(x, y) / float(SAMPLES_INNER) - 0.5) * _Size;
            
            _Offset *= _Pixel;
            
            _Alpha += texture2D(imgTexture, In + _Offset).a * _Tint;
            _Idx += 1.0;
        }
    }
    
    _Alpha /= _Idx;

    return _Alpha;
}

vec2 Fun_Mirror(vec2 In)
{
    return 1.0 - abs(fract(In / 2.0) * 2.0 - 1.0);
}

void main(void)
{  
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Texture_NT = texture2D(imgTexture, In);
    //vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result = vec4(0.0);
        vec2 _Pixel = vec2(fPixelWidth, fPixelHeight);
            
            vec2 _UV = In;
            //_UV.z = max(abs(_UV.x - 0.5), abs(_UV.y - 0.5)) * 2.0;
            //_UV.z = 1.0 - pow(_UV.z, 10.0);

            _UV = Fun_Mirror(In);

            float _Lum = dot(_Render_Texture_NT.rgb, vec3(0.212, 0.715, 0.072));
            float _Mirror = Fun_Inner(In, _Pixel, blendColor.a);
            float _MirrorCopy = _Mirror;

                _Mirror *= pow(_Lum, 6.0);

            vec2 _Off = Fun_Mirror(_UV + ((_UV - 0.5) / max(0.01, _Mirror)) * _Liquid);

                _Result.rgb = Fun_Blur(_Off, _Pixel);
                _Result.rgb = mix(vec3(0.3, 0.3, 0.3), _Result.rgb, 0.9);

            _Result.rgb += clamp(smoothstep(0.3, 0.6, _Mirror + abs(1.4 - _MirrorCopy)), 0.0, 1.0) * _Off.x * _Off.y * 0.5;
            _Result.rgb *= mix(vec3(1.0), _Render_Texture.rgb * _Lum, _Mul);
            _Result.rgb = mix(_Render_Texture.rgb, _Result.rgb, _Mixing);

        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

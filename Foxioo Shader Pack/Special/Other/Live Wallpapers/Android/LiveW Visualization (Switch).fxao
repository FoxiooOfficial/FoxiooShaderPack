/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;
uniform float _Time;
uniform bool _Is_Pre_296_Build;
uniform float _Alpha;

/************************************************************/
/* Main */
/************************************************************/

void main(void)
{
    vec2 In_Background = In;
    if(_Is_Pre_296_Build) In_Background.y = 1.0 - In_Background.y;

    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In_Background);

        vec4 _Result, _Render;

        if(!_Blending_Mode)
        {
            _Render = _Render_Texture;
        }
        else
        {
            _Result.a = _Render_Texture.a;
    
            _Render = _Render_Background;
        }

        _Result.rgb = mix(_Render.rgb, vec3(0.0, 0.0, 0.0), _Alpha);

        float t = _Time;

        float _Off = cos(In.x * 2.0 - t * 0.6
                        + sin(In.x * 0.031 - t * 2.0) * 0.1
                        - sin(In.x * 4.0 - t * 0.2) * 0.2
                        + cos(In.x * 0.0115 - t) * 0.1
                        - cos(In.x / 0.1 - t * 2.0) * 0.3
                        + sin(t * 0.02) * 0.1
                    ) * 0.2;

        vec2 _UV = vec2(In + vec2(0.0, -0.5 + _Off)) * vec2(960.0, 4.0);
        float _High = (1.0 / _Off) / 8.0;

        float _Y =  sin(_UV.x * 0.002 + t) * 160.0 +
                    sin(_UV.x * 0.007 + t) * 80.0 +
                    sin(_UV.x * 0.023 - t) * 40.0 +
                    sin(_UV.x * 0.011 + t) * 20.0 +
                    sin(_UV.x * 0.031 - t) * 10.0;

        _Y /= 310.0;

            vec2 _Size = vec2(_Y / _High, -_Y / _High);

                float _Min = min(_Size.x, _Size.y);
                float _Max = max(_Size.x, _Size.y);
                float _Lerp = _UV.y - _Off * 2.0;

        float _Hight = 0.02;
        float _Wave = smoothstep(_Min - _Hight, _Min, _Lerp) * smoothstep(_Max + _Hight, _Max, _Lerp);
        float _Gradient = clamp(abs(_Lerp) / _Max, 0.0, 1.0);

        const vec3 _Blue = vec3(0.0, 0.0, 1.0);
        const vec3 _White = vec3(1.0, 1.0, 1.0);

        _Result.rgb = mix(_Result.rgb, _Result.rgb + mix(_White, _Blue, _Gradient), _Wave);
        _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);

    gl_FragColor = _Result;
}

//@End
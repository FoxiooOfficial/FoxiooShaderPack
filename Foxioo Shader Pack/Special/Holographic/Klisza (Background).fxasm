/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c1, 0.772548974, 0.168626994, 0.0470580012, 0.587000012;
            def c2, 0.992156029, 0.654901028, 0.160784006, 0.298999995;
            def c3, 0, 0, 0, 0.114;
            def c4, 0, 0, 0, -1;
            def c5, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r0, t0;
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r2.w, r1.y, c1.w;
                mad r2.w, r1.x, c2.w, r2.w;
                mad r2.w, r1.z, c3.w, r2.w;
                mul r2.w, r2.w, r2.w;
                mul r3.xyz, 1-r2.w, c1;
                mad r2.xyz, r2.w, c2, r3;
                mov r3.x, r0.w;
                phase;
                mov r3.w, r3.x;
            + mul r2.xyz, r2, 1-r0;
                mul r4.w, c0.x, c4.w;
            + mul r1.xyz, r1, r2;
                add r2.w, r4.w, c5.w;
                mul r0.xyz, r0, r2.w;
            + mov r0.w, r3.w;
                mad r0.xyz, r1, c0.x, r0;
        };
    }
}
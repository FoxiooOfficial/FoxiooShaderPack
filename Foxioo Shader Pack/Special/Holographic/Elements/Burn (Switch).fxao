/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform sampler2D _Texture_Fire;
uniform sampler2D _Texture_Mask;
uniform float _Offset;
uniform float _Mixing;
uniform bool _Blending_Mode;

/************************************************************/
/* Main */
/************************************************************/

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);
    vec4 _Render_Ice = texture2D(_Texture_Fire, In);
    vec4 _Render_Mask = texture2D(_Texture_Mask, In);

        vec4 _Result;
        vec4 _Render;

            vec2 _Size = vec2(fPixelWidth, fPixelHeight);
            if(!_Blending_Mode)
            {
                _Result = texture2D(imgTexture, fract(In + _Size * (vec2(_Render_Ice.rb - 0.5) * _Render_Ice.b * _Offset))) * blendColor;
                _Render = _Render_Texture;
            }
            else
            {
                _Result = texture2D(bckgTexture, fract(In + _Size * (vec2(_Render_Ice.rb - 0.5) * _Render_Ice.b * _Offset)));
                _Render = _Render_Background;
            }

        float _StepAlpha = smoothstep(1.0, 0.0, pow((_Mixing - _Render_Mask.r), 10.0));
        vec3 _ColorFire = _Render_Ice.rgb * _Render_Ice.rgb * 2.0 + _Render_Ice.rgb + pow(distance(_Render_Mask.r, _Mixing + 0.1), 10.0) * vec3(0.8, 0.7, 0.0);

        _Result.rgb = mix(_Render.rgb, vec3(0.0), clamp(pow(distance(_Render_Mask.r, max(0.0, _Mixing) + 0.2), _Offset) * 40.0, 0.0, 1.0));
        _Result.rgb = mix(_Result.rgb, _ColorFire, pow(distance(_Render_Mask.r, max(0.0, _Mixing) + 0.2), _Offset));
        _Result.a = mix(_Result.a, _Result.a * _StepAlpha, clamp(_Mixing, 0.0, 1.0));

            _Result.rgb += _Render_Background.rgb * _StepAlpha * pow(distance(_Render_Mask.r, _Mixing + 0.2), _Offset);
        
        _Result = mix(_Render, _Result, clamp(_Mixing, 0.0, 1.0));
        _Result.a *= _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Border;

/************************************************************/
/* Main */
/************************************************************/

const int SAMPLES_INNER  = 12;
#define PIXELSIZE               vec2(fPixelWidth, fPixelHeight)

float Fun_Inner(vec2 In)
{
    float _Alpha = 0.0;
    for(int y = 0; y <= SAMPLES_INNER; y++)
    {
        for(int x = 0; x <= SAMPLES_INNER; x++)
        {
            vec2 _Offset = (vec2(x, y) / float(SAMPLES_INNER) - 0.5);
            float _Render = texture(imgTexture, In + _Offset * _Border * PIXELSIZE).a;

            _Alpha += _Render;
        }
    }
    return _Alpha / float(SAMPLES_INNER * SAMPLES_INNER);
}

float Fun_Lum (vec4 _Result) { 
    return (0.2126 * _Result.r + 0.7152 * _Result.g + 0.0722 * _Result.b) * _Result.a;
}

float Fun_Random(vec2 In) {
    return fract(sin(dot(In, vec2(12.9898, 78.233))) * 43758.5453);
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = texture(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture(bckgTexture, In);

    float _Rand = Fun_Random(In + _Render_Texture.rb + _Render_Texture.bg + _Render_Background.rg + _Render_Background.br);
    float _Lum = Fun_Lum(_Render_Texture);
    float _Lum_Background = Fun_Lum(_Render_Background);

        vec3 _Space = mix(vec3(0.0, 0.0, 0.0), vec3(0.15, 0.05, 0.25), _Lum);
        _Space += (_Space * (texture(bckgTexture, In + tan(_Lum) * _Lum * 0.25 - tan(_Lum_Background) * 0.25 - _Rand).rgb) * 1.5);
        _Space *= 0.5;

            vec3 _Void = texture(bckgTexture, In + (_Render_Background.rg * (1.0 - _Render_Texture.rg) + _Rand) * 0.1).rgb;
            _Space = mix(_Space, _Space + _Void * vec3(0.15, 0.05, 0.25), 1.0 - _Lum);

            vec4 _Result = _Render_Texture;
            _Result.rgb = mix( _Render_Texture.rgb, 
                                _Space + pow(Fun_Random(In + _Space.rb + _Space.bg + _Render_Background.rg + _Render_Background.br + _Rand), 255.0), 
                                _Mixing);

            float _Inner = (1.0 - Fun_Inner(In)) * _Render_Texture.a;
            _Result.rgb += ((_Inner / pow(cos(_Lum - _Inner), 6.0)) * clamp(_Mixing, 0.0, 1.0)) * 0.05;
            _Result.rgb += clamp(_Inner * _Inner + (1.0 - _Lum) * 0.15, 0.0, 1.0) * 4.0;
            
        _Result = mix(_Render_Texture, _Result, _Mixing);

    fragColor = _Result;
}
//@End
/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Time;
uniform bool _Blending_Mode;

uniform sampler2D _Texture;

/************************************************************/
/* Main */
/************************************************************/

vec3 Fun_Aurora(float _Noise)
{
    const vec3 _Light_Hight = vec3(0.3882, 0.8039, 0.9059);
    const vec3 _Light_Medium = vec3(0.06, 0.7, 0.62);
    const vec3 _Light_Low = vec3(0.0392, 0.4863, 0.3882);
    const vec3 _Light_Null = vec3(0.0,0.0, 0.0);


    vec3 _Aurora = mix(_Light_Null, _Light_Low, smoothstep(0.0, 0.33, _Noise));
    _Aurora = mix(_Aurora, _Light_Medium, smoothstep(0.33, 1.0, _Noise));
    _Aurora = mix(_Aurora, _Light_Hight,  smoothstep(1.0, 2.0, _Noise));

    return _Aurora;
}

const float _Max = 25.0;

void main(void)
{  
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec4 _Render = _Result;

        _Result.a = _Render_Texture.a;

        _Result.rgb = vec3(dot(pow(abs(_Result.rgb),  vec3(6.0)),vec3(0.2126, 0.7152, 0.0722)));
        float Wave = sin(_Mixing * 10.0);

        for (int i = 1; i < int(_Max); i++)
        {
            float w = In.x;
        
            w += sin((1.0 - In.y) * 2.0 + _Time) / 60.0;
            w = abs(sin(-w * 10.0 * float(i) / _Max * 2.0 + _Time / float(i)) / 20. + sin(40.0 * float(i) / _Max + _Time) / 18.0) * 35.0;

                w += ((1.0 - In.y) * 2.4 - 1.6);
                w = smoothstep(0.4, 0.7, w / 5.0) / 20.0;

            float _Color = 1.0 - (abs(In.y - 0.5)) * 3.0;
            _Color += (In.x + 4.0 + Wave * 0.5 + 0.5) * 0.3;

                vec3 _Perlin = texture2D(_Texture, fract(In * 0.3 + vec2(_Time * float(i) / 100.0, 0.0))).rgb;
                float _Lum = (_Perlin.r + _Perlin.g + _Perlin.b) / 32.0;

            _Result.rgb += (5.0 / _Max) * (Fun_Aurora(0.7 * (_Color + In.x + _Time)) * w * 5.0 + Fun_Aurora(_Lum));
        }

        _Result.rgb += Fun_Aurora(1.0 - abs(In.y * In.y * 2.0 - 0.8)) * In.y;
        _Result.rgb = mix(_Render.rgb, pow(abs(_Result.rgb), vec3(2.0)) * 1.8, _Mixing);

    gl_FragColor = _Result;
}

//@End

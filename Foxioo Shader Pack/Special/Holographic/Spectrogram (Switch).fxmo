/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Time;
uniform float _Mixing;
uniform bool _Blending_Mode;

/************************************************************/
/* Main */
/************************************************************/

float Fun_Lum(vec4 _Result) { 
    return (0.2126 * _Result.r + 0.7152 * _Result.g + 0.0722 * _Result.b);
}

vec2 Fun_UV(vec2 UV, float _Lum) {
    return vec2(_Lum * sin(_Lum + UV.x * _Lum * 200.0 * _Mixing + _Time) * 0.01 * _Mixing, _Lum * cos(_Lum + UV.y * 400.0 * _Mixing + sin(UV.x * 10.0 + _Time * _Lum) + _Time) * 0.01 * _Mixing);
}

out vec4 fragColor;
void main(void)
{   
    vec4 _Render_Texture = texture(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture(bckgTexture, In);

    vec4 _Result, _Render;
    
        if(!_Blending_Mode) {   
            _Render = _Render_Texture;

        }
        else {
            _Render.rgb = _Render_Background.rgb;
            _Render.a = _Render_Texture.a;
        }

        _Result = _Render_Texture;

            const vec3 _Color0 = vec3(1.0, 1.0, 1.0); // Whi
            const vec3 _Color1 = vec3(1.0, 1.0, 0.0); // Yel
            const vec3 _Color2 = vec3(1.0, 0.0, 0.0); // Red
            const vec3 _Color3 = vec3(0.5, 0.0, 0.5); // Pur
            const vec3 _Color4 = vec3(0.0, 0.0, 0.25); // Blu
            const vec3 _Color5 = vec3(0.0, 0.0, 0.0); // Blk

                float _Lum = Fun_Lum(_Result);
                vec2 _Off = Fun_UV(In, _Lum);
                    
                if(!_Blending_Mode) {
                    _Result = texture(imgTexture, In + _Off);
                }
                else {
                    _Result.rgb = texture(bckgTexture, In + _Off).rgb;
                    _Result.a = _Render.a;
                }

                    _Lum = Fun_Lum(_Result);
                    if (_Lum < 0.2)         _Result.rgb = mix(_Color5, _Color4, _Lum / 0.2);
                    else if (_Lum < 0.4)    _Result.rgb = mix(_Color4, _Color3, (_Lum - 0.2) / 0.2);
                    else if (_Lum < 0.6)    _Result.rgb = mix(_Color3, _Color2, (_Lum - 0.4) / 0.2);
                    else if (_Lum < 0.8)    _Result.rgb = mix(_Color2, _Color1, (_Lum - 0.6) / 0.2);
                    else                    _Result.rgb = mix(_Color1, _Color0, (_Lum - 0.8) / 0.2);

            _Result = mix(_Render, _Result, _Mixing);

    fragColor = _Result;
}
//@End
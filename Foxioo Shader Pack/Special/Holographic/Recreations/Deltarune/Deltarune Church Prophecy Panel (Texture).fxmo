/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform float _OffsetX;
uniform float _OffsetY;
uniform float fPixelWidth;
uniform float fPixelHeight;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 InOff = abs(vec2(_OffsetX, _OffsetY) * _PixelSize * 2.0);
    vec2 _DirCorner = sign(In - 0.5);

        vec2 _PixelPadding = InOff / _PixelSize; // Radius
        vec2 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding;

    vec3 pos = vec3(_PosExpanded, 1.0);
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);

    In = In + _DirCorner * InOff / _PixelSize;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;
uniform sampler2D _Texture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;

uniform float _PosX;
uniform float _PosY;
uniform float _OffsetX;
uniform float _OffsetY;

uniform float _Scale;
uniform float _ScaleX;
uniform float _ScaleY;

uniform bool _Color;

uniform vec4 _ColorLight;
uniform vec4 _ColorShadow;

/************************************************************/
/* Main */
/************************************************************/

float Fun_Lum(vec4 _Result) {
    return dot(_Result.rgb, vec3(0.2126, 0.7152, 0.0722)) * _Result.a;
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = texture(imgTexture, In) * blendColor;

        /* main panel */
        vec2 UV = In + vec2(_PosX, _PosY);
        UV = (UV * vec2(_ScaleX, _ScaleY) * _Scale) / 256.0;
        UV /= vec2(fPixelWidth, fPixelHeight);
        UV = UV - floor(UV); // frac(UV)?

            float _Render_Texture_Lum = Fun_Lum(_Render_Texture);
            vec4 _Texture_UV = texture(_Texture, UV);

            vec4 _Result = _Texture_UV;
            float _Result_Lum = Fun_Lum(_Result);

            _Result.a *= _Render_Texture_Lum;

            // sub panels
            vec2 _UV_Echo = vec2(_OffsetX, _OffsetY) * vec2(fPixelWidth, fPixelHeight);
            
                vec4 _Echo1 = texture(imgTexture, In + _UV_Echo) * blendColor;
                    _Result.a += Fun_Lum(_Echo1) / 2.0;

                vec4 _Echo2 = texture(imgTexture, In + _UV_Echo * 2.0) * blendColor;
                    _Result.a += Fun_Lum(_Echo2) / 3.0;

        /* End */
            if(_Color)
                _Result.rgb = mix(_ColorShadow.rgb, _ColorLight.rgb, _Result_Lum);

        _Result = mix(_Render_Texture, _Result, _Mixing);

    fragColor = _Result;
}
//@End
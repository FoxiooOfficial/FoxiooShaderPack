/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Mixing: f32,
    parameter2_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_Luminance(_Result: vec3f) -> f32 {
    const _Kr: f32 = 0.299;
        const _Kg: f32 = 0.587;
        const _Kb: f32 = 0.114;

        return _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Lum: f32 = Fun_Luminance(vec3f(_Render_Texture.rgb));
            var _LumBg: f32 = Fun_Luminance(vec3f(_Render_Background.rgb));
            var _Render_Texture_Lum: f32 = Fun_Luminance(vec3f(texture2D(img, input.texCoord + vec2f(fusion.fPixelWidth, fusion.fPixelHeight) * (_Lum - _LumBg)).rgb));

            var CD: vec2f = input.texCoord - 0.5 - _Lum * 0.1;
            var _Dist: f32 = length(CD);
            CD = vec2f(smoothstep(0.5, 0.0, length(vec2f(CD.x - 0.5, CD.y)) * 0.1 + cos(CD.y) * 0.1));
            CD = fract(CD / 2.0);
            CD = abs(CD * 2.0 - 1.0);

            const _Frag: f32 = 6.28318;
            var _CDOffset: vec4f = vec4f(sin(_Frag * CD.x + CD.y) * 0.5 + 0.5, sin(_Frag * CD.x + CD.y + 2.0) * 0.5 + 0.5, sin(_Frag * CD.x + CD.y + 4.0) * 0.5 + 0.5, 1);

                var _Result: vec4f = texture2D(background, input.texCoord + CD * 0.1);
                {
                    let _fusionSwizzle0 = mix(vec3f(0.529, 0.541, 0.568) * _Result.rgb * 0.15, vec3f(0.529, 0.541, 0.568) + _Result.rgb * 0.5, Fun_Luminance(vec3f(_Result.rgb)));
                    _Result.x = _fusionSwizzle0.x;
                    _Result.y = _fusionSwizzle0.y;
                    _Result.z = _fusionSwizzle0.z;
                }
                {
                    let _fusionSwizzle1 = mix(_Result.rgb, vec3f(_Render_Texture_Lum) * 0.5, 0.95 + _Lum * 0.05);
                    _Result.x = _fusionSwizzle1.x;
                    _Result.y = _fusionSwizzle1.y;
                    _Result.z = _fusionSwizzle1.z;
                }

            var _CDRainbow: vec3f = vec3f(sin(_Frag * atan(((input.texCoord.x - input.texCoord.y) + (CD.x + CD.y) * 0.1 - _LumBg))) * 0.5 + 0.5, sin(_Frag * atan(((input.texCoord.x + input.texCoord.y) + (CD.x - CD.y) * 0.1 - _LumBg) * 1.2) + 2.0) * 0.5 + 0.5, sin(_Frag * atan(((input.texCoord.x - input.texCoord.y) + (CD.x + CD.y) * 0.1 - _LumBg) * 1.4) + 4.0) * 0.5 + 0.5);

                {
                    let _fusionSwizzle2 = _CDRainbow * 0.1;
                    _Result.x += _fusionSwizzle2.x;
                    _Result.y += _fusionSwizzle2.y;
                    _Result.z += _fusionSwizzle2.z;
                }

            var _OrFreq: f32 = mix(300.0, 1000.0, _Dist * _LumBg);
            var _OrPtr: f32 = sin(_Dist * _OrFreq) * 0.5 + 0.5;
            _OrPtr = smoothstep(0.3, 0.7, _OrPtr);

                    var _Angle: f32 = atan2((input.texCoord.y + _OrPtr * 0.01) - 0.5, (input.texCoord.x + _OrPtr * 0.01) - 0.5);
                    var _RayPattern: f32 = abs(sin(_Angle + (1.0 - (_LumBg - _Lum))));
                    _RayPattern = smoothstep(0.0, 3.0 * _Lum, 0.5 * clamp(_RayPattern * _Lum * 0.25 * abs(_LumBg - atan2((input.texCoord.y + _OrPtr * 0.01), _LumBg - (input.texCoord.x + _OrPtr * 0.01))), 0.0, 1.0));

                        {
                            let _fusionSwizzle3 = mix(_Result.rgb, _Result.rgb + _CDOffset.rgb + _CDRainbow.rgb * 1.2, _RayPattern * 2.0);
                            _Result.x = _fusionSwizzle3.x;
                            _Result.y = _fusionSwizzle3.y;
                            _Result.z = _fusionSwizzle3.z;
                        }

                    _RayPattern = abs(sin(_Angle * 2.0 + (_LumBg - _Lum)));
                    _RayPattern = smoothstep(0.0, 3.0 * _Lum, clamp(_RayPattern * _Lum * 0.25 * abs(atan2((_OrPtr * 0.01 - CD.y), (_OrPtr * 0.01 - CD.x))), 0.0, 1.0));

                    {
                        let _fusionSwizzle4 = mix(_Result.rgb, _Result.rgb + _CDOffset.rgb + _CDRainbow.rgb * 1.2, _RayPattern * 3.0);
                        _Result.x = _fusionSwizzle4.x;
                        _Result.y = _fusionSwizzle4.y;
                        _Result.z = _fusionSwizzle4.z;
                    }

            {
                let _fusionSwizzle5 = mix(_Result.rgb, _Result.rgb + _CDOffset.rgb * 1.5 * _Dist, _OrPtr * 0.05);
                _Result.x = _fusionSwizzle5.x;
                _Result.y = _fusionSwizzle5.y;
                _Result.z = _fusionSwizzle5.z;
            }
            {
                let _fusionSwizzle6 = mix(_Render_Texture.rgb, _Result.rgb, params._Mixing);
                _Result.x = _fusionSwizzle6.x;
                _Result.y = _fusionSwizzle6.y;
                _Result.z = _fusionSwizzle6.z;
            }

            _Result.a = _Render_Texture.a;

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

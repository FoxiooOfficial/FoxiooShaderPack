/***********************************************************/

/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

    float _Mixing;
    float _Threshold;

    float _Blending_Mode;
    float _Negative;

    vector _ColorLight;
    vector _ColorShadow;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Threshold>;      // c1
        PixelShaderConstant[2] = <_Blending_Mode>;  // c2
        PixelShaderConstant[3] = <_Negative>;       // c3
        PixelShaderConstant[4] = <_ColorLight>;     // c4
        PixelShaderConstant[5] = <_ColorShadow>;    // c5
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c6, 0.298999995, 0.587000012, 0.114, -1;
            def c7, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r0, t0;
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r2.w, c2.x, c6.w;
                cmp r1.xyz, r2.w, r0, r1;
                add r2.xyz, r1, c1.x;
                dp3 r2.w, r2, c6;
                add r2.w, -r2.w, c3.x;
                cmp r2.w, r2.w, r2.w, -r2.w;
            + mov r0.x, r0.w;
                mov r0.y, r2.w;

                phase;

                mov r2.w, r0.x;
                mov r0.w, r0.y;
                mul r3.w, c0.x, c6.w;
            + cmp r0.xyz, r0_bias.w, c4, c5;
                add r3.w, r3.w, c7.w;
                mul r1.xyz, r1, r3.w;
            + mov r0.w, r2.w;
                mad r0.xyz, r0, c0.x, r1;
        };
    }
}
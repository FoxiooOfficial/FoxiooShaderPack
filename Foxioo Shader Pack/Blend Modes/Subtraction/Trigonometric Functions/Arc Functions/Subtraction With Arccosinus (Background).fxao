/* ####################################################### */


//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;
uniform int _Render_Switch;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

#define M_PI 3.14159265359
#define M_PI_2 1.57079632679
#define M_NAN sqrt(-1.0)

vec3 Fun_Real(vec3 _Color, vec3 _Render)
{   
    float NaN = _Mixing < 0.0 ? M_NAN : 0.0;
    return mix(_Render, vec3(NaN), vec3(greaterThan(abs(_Color), vec3(1.0))));
}

vec3 Fun_Acos(vec3 _Color, int _Case)
{   
    vec3 _Render = acos(_Color);
    vec3 _Real = Fun_Real(_Color, _Render);

    if(_Case == 0)
        return _Render;

    else if(_Case == 1) // D3D9 simulated
    { 
        float a = -1.0 / M_PI * 1.07596;
        vec3 _Out = vec3(0.0);

        vec3 _Neg = M_PI_2 - (a * pow(_Color + M_PI, vec3(2.0)));
        vec3 _Pos = M_PI_2 - (-a * pow(-_Color + M_PI, vec3(2.0)));

        _Out = mix(_Out, _Neg, vec3(lessThan(_Color, vec3(-1.0))));
        _Out = mix(_Out, _Pos, vec3(greaterThan(_Color, vec3(1.0))));

        return clamp(_Out * 1.3 + 0.1, 0.0, 1.0) + clamp(_Real, 0.0, 1.0);
    }

    else if(_Case == 2) // D3D11, OGL simulated
    {
        return _Real;
    }

    else return vec3(0.0);
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result, _Render;

                if(!_Blending_Mode)
                { 
                    _Result.rgb = Fun_Acos(_Render_Texture.rgb - (_Render_Background.rgb * _Mul), _Render_Switch);
                    _Render = _Render_Texture;
                }
                else
                { 
                    _Result.rgb = Fun_Acos((_Render_Background.rgb * _Mul) - _Render_Texture.rgb, _Render_Switch);
                    _Render = _Render_Background;
                } 
    
            _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);

        _Result.a = _Render_Texture.a;

	gl_FragColor = _Result;
}

//@End

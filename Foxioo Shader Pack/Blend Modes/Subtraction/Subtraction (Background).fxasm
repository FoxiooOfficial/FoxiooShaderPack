/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mul;
float _Mixing;
dword _Blending_Mode;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mul>;            // c0
        PixelShaderConstant[1] = <_Mixing>;         // c1
        PixelShaderConstant[2] = <_Blending_Mode>;  // c2

        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c3, 0, 0, 0, -1;
            def c4, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r2.xyz, r1, c0.x

                phase
                
                texld r0, t0
                add r3.xyz, r0, -r2
            + mul r4.w, c2.x, c3.w
                add r2.xyz, r2, -r0
                cmp r2.xyz, r4.w, r3, r2
            + mul r3.w, c1.x, c3.w
                cmp r1.xyz, r4.w, r0, r1
            + add r3.w, r3.w, c4.w
                mul r1.xyz, r1, r3.w
            + mov r0.w, r0.w
                mad r0.xyz, r2, c1.x, r1
        };
    }
}
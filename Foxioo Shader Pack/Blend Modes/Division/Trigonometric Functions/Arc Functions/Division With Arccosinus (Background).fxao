/* ####################################################### */


//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;
uniform int _Render_Switch;
uniform bool _Blending_Mode;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

#define M_PI 3.14159265359
#define M_PI_2 1.57079632679

vec3 Fun_Real(vec3 _Color, vec3 _Render)
{   
    float NaN = _Mixing < 0.0 ? sqrt(-1.0) : 0.0;

    vec3 _Result;

		_Result.r = abs(_Color.r) > 1.0 ? NaN : _Render.r;
		_Result.g = abs(_Color.g) > 1.0 ? NaN : _Render.g;
		_Result.b = abs(_Color.b) > 1.0 ? NaN : _Render.b;

    return _Result;
}

vec3 Fun_Acos(vec3 _Color, int _Case)
{   
    vec3 _Render = acos(_Color);
    vec3 _Real = Fun_Real(_Color, _Render);

    if(_Case == 0)
        return _Render;

    else if(_Case == 1) // D3D9 simulated
    { 
        float a = -1.0 / M_PI * 1.07596;
        float p = -M_PI;
        vec3 _Out;

        if(_Color.r < -1.0 || _Color.g < -1.0 || _Color.b < -1.0)
            _Out =  M_PI_2 - (a * pow((_Color - p), vec3(2.0)));
            
        else if(_Color.r > 1.0 || _Color.g > 1.0 || _Color.b > 1.0)
            _Out =  M_PI_2 - (-a * pow((-_Color - p), vec3(2.0)));

        else
            _Out =  _Render;

          return clamp(_Out, 0.0, 1.0) + clamp(_Real, 0.0, 1.0);
    }

    else if(_Case == 2) // D3D11, OGL simulated
    {
        return _Real;
    }

    else return vec3(0.0);
}

void main(void)
{
    vec2 In_Background = In;
    if(_Is_Pre_296_Build) In_Background.y = 1.0 - In_Background.y;

    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In_Background);

        vec4 _Result;

            int _Switch = _Render_Switch;
                if(_Switch < 0) _Switch = 0;
                if(_Switch > 2) _Switch = 2;

            if(!_Blending_Mode) _Result.rgb = Fun_Acos(_Render_Texture.rgb / (_Render_Background.rgb * _Mul), _Switch);
            else                _Result.rgb = Fun_Acos((_Render_Background.rgb * _Mul) / _Render_Texture.rgb, _Switch);

            _Result.rgb = mix(_Render_Texture.rgb, _Result.rgb, _Mixing);

        _Result.a = _Render_Texture.a;

	gl_FragColor = _Result;
}

//@End

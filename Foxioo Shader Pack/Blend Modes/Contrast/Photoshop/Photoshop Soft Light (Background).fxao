/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform bool _Is_Pre_296_Build;

/************************************************************/
/* Main */
/************************************************************/

float Fun_SoftLight(float _Render_Texture, float _Render_Background)
{
    if(_Render_Background < 0.5)
        return mix(_Render_Texture, (2.0 * _Render_Texture - 1.0) * (_Render_Background - pow(_Render_Background, 2.0)) + _Render_Background, _Mixing);
        
    else
        return mix(_Render_Texture, (2.0 * _Render_Texture - 1.0) * (sqrt(_Render_Background) - _Render_Background) + _Render_Background, _Mixing);   
}

void main(void)
{
    vec2 In_Background = In;
    if(_Is_Pre_296_Build) In_Background.y = 1.0 - In_Background.y;

    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In_Background);

        vec4 _Result;

            _Result.r = Fun_SoftLight(_Render_Texture.r, _Render_Background.r);
            _Result.g = Fun_SoftLight(_Render_Texture.g, _Render_Background.g);
            _Result.b = Fun_SoftLight(_Render_Texture.b, _Render_Background.b);

        _Result.a = _Render_Texture.a;


    gl_FragColor = _Result;
}

//@End

/* ####################################################### */

/***********************************************************/
/* Samplers */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

    float _Mixing;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0

        PixelShader = asm
        {
            ps.1.4

            /** Consts ************************************************/
            def c1, -0.899999976, -0.899999976, -0.899999976, 1
            def c2, 5, 5, 5, -1

            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                r1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);

                t0 -> float2 In : TEXCOORD0;
            */
            texld r0, t0
            texld r1, t0

            
            add r1.xyz, r1, r0
            add r1.xyz, r1, c1
            mul r1.xyz, r1, c2
            + mul r2.w, c0.x, c2.w
            add r1.xyz, r1_x2, r1_x2
            + add r2.w, r2.w, c1.w
            mul r2.xyz, r0, r2.w
            + mov r0.w, r0.w
            mad r0.xyz, r1, c0.x, r2
        };
    }
}

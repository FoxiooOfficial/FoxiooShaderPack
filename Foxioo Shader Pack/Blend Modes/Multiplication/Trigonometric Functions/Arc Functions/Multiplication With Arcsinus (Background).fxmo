/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform float _Mul;
uniform int _Render_Switch;

/************************************************************/
/* Main */
/************************************************************/

#define M_PI 3.14159265359
#define M_PI_2 1.57079632679
#define M_NAN sqrt(-1.0)

vec3 Fun_Real(vec3 _Color, vec3 _Render)
{   
    float NaN = _Mixing < 0.0 ? M_NAN : 0.0;
    return mix(_Render, vec3(NaN), vec3(greaterThan(abs(_Color), vec3(1.0))));
}

vec3 Fun_Asin(vec3 _Color, int _Case)
{   
    vec3 _Render = asin(_Color);
    vec3 _Real = Fun_Real(_Color, _Render);

    if(_Case == 0) // Native
        return _Render;

    else if(_Case == 1) // D3D9 simulated
    { 
        float a = -1.0 / M_PI * 1.07596;
        
        vec3 _Out = vec3(0.0);

        vec3 _Neg = _Color + M_PI;
       _Neg = a * (_Neg * _Neg);
        
        vec3 _Pos = -_Color + M_PI;
        _Pos = -a * (_Pos * _Pos);

        _Out = mix(_Out, _Neg, vec3(lessThan(_Color, vec3(-1.0))));
        _Out = mix(_Out, _Pos, vec3(greaterThan(_Color, vec3(1.0))));

        return clamp(_Out / (M_PI * 0.43), 0.0, 1.0) + clamp(_Real, 0.0, 1.0);
    }

    else if(_Case == 2)
        return _Real;
        
    else 
        return vec3(0.0);
}

out vec4 fragColor;
void main(void)
{	
	vec4 _Render_Texture = texture(imgTexture, In) * blendColor;
	vec4 _Render_Background = texture(bckgTexture, In);

		vec4 _Result = _Render_Texture * (_Render_Background * _Mul);

            _Result.rgb = Fun_Asin(_Result.rgb, _Render_Switch);
            _Result.rgb = mix(_Render_Texture.rgb, _Result.rgb, _Mixing);

        _Result.a = _Render_Texture.a;

	fragColor = _Result;
}
//@End
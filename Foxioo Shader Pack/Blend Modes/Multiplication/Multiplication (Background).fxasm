/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mul;
float _Mixing;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mul>;         // c0
        PixelShaderConstant[1] = <_Mixing>;      // c1
        
        PixelShader = asm
        {
            ps.1.1;
            
            /** Consts **************************************************/
            def c2, 1, 0, 0, -1;
            def c3, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            tex t0;
            tex t1;
            
            /** Assembly ************************************************/

                dp3 r0.xyz, c2, c0;
                mul r0.xyz, t1, r0;
                dp3 r1, c2, c1;
                mul r1.w, r1.w, c2.w;
            + mul r0.xyz, t0, r0;
                add r1.w, r1.w, c3.w;
                mul r1.xyz, t0, r1.w;
            + mov r0.w, t0.w;
                dp3 t1.xyz, c2, c1;
                mad r0.xyz, r0, t1, r1;
        };
    }
}
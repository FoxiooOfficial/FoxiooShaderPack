/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
dword _Blending_Mode;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;
        
        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts ************************************************/
            def c2, 1, 1, 1, -1;
            def c3, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                r1 -> float4 _Render_Background = tex2D(S2D_Background, In);

                t0 -> float2 In : TEXCOORD0;
            */
            texld r0, t0;
            texld r1, t0;
            
            add_d2 r2.xyz, r0, r1;
            add r2.xyz, -r2, c2;
            + mul r3.w, c1.x, c2.w;
            cmp r2.xyz, r3.w, 1-r1, r2;
            + mul r4.w, c0.x, c2.w;
            cmp r1.xyz, r3.w, r1, r0;
            + add r3.w, r4.w, c3.w;
            mul r1.xyz, r1, r3.w;
            + mov r0.w, r0.w;
            mad r0.xyz, r2, c0.x, r1;
        };
    }
}
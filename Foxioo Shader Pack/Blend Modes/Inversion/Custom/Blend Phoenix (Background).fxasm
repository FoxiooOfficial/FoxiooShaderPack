/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
float _Blending_Mode;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;
        
        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts ************************************************/
            def c1, 1, 1, 1, -1;
            def c2, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);

                t0 -> float2 In : TEXCOORD0;
            */
            texld r0, t0;
            
            mul r1.w, c0.x, c1.w
            add r1.w, r1.w, c2.w
            mul r2.xyz, r0, r1.w
            + mov r1.w, r0.w
            mov r3.x, r1.w
            phase
            texld r1, t0
            mov r0.w, r3.x
            + add r4.xyz, r0, -r1
            cmp r5.xyz, r4, r0, r1
            cmp r0.xyz, r4, r1, r0
            add r0.xyz, r0, -r5
            add r0.xyz, r0, c1
            mad r0.xyz, r0, c0.x, r2
        };
    }
}
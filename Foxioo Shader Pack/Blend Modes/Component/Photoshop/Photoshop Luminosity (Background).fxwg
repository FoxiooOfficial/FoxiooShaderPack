/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32, // _
    _Mixing: f32,
    parameter2_value: i32, // __
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/

/*  All color calculations are taken from:
    https://printtechnologies.org/standards/files/pdf-reference-1.6-addendum-blend-modes.pdf */

/***********************************************************/
fn Fun_Luminance(_Result: vec3f) -> f32 {
    const _Kr: f32 = 0.299;
        const _Kg: f32 = 0.587;
        const _Kb: f32 = 0.114;

        var _Y: f32 = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

        return _Y;
}

fn Fun_ClipColor(_Color: vec3f) -> vec3f {
    var _fusionParamColor = _Color;
    var _Y: f32 = Fun_Luminance(vec3f(_fusionParamColor));
        var _ColorMin: f32 = min(_fusionParamColor.r, min(_fusionParamColor.g, _fusionParamColor.b));
        var _ColorMax: f32 = max(_fusionParamColor.r, max(_fusionParamColor.g, _fusionParamColor.b));

        if(_ColorMin < 0.0) { _fusionParamColor = _Y + (((_fusionParamColor - _Y) * _Y) / (_Y - _ColorMin)); }
        if(_ColorMax > 1.0) { _fusionParamColor = _Y + (((_fusionParamColor - _Y) * (1.0 - _Y)) / (_ColorMax - _Y)); }

        return _fusionParamColor;
}

fn Fun_SetLum(_Color: vec3f, _Y: f32) -> vec3f {
    var _fusionParamColor = _Color;
    var _GetLum: f32 = _Y - Fun_Luminance(vec3f(_fusionParamColor));
        _fusionParamColor += _GetLum;

        return Fun_ClipColor(vec3f(_fusionParamColor));
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Render: vec4f;
            var _Result: vec4f;

                {
                    let _fusionSwizzle0 = Fun_SetLum(vec3f(_Render_Background.rgb), f32(Fun_Luminance(vec3f(_Render_Texture.rgb))));
                    _Render.x = _fusionSwizzle0.x;
                    _Render.y = _fusionSwizzle0.y;
                    _Render.z = _fusionSwizzle0.z;
                }
                {
                    let _fusionSwizzle1 = mix(_Render_Texture.rgb, _Render.rgb, params._Mixing);
                    _Result.x = _fusionSwizzle1.x;
                    _Result.y = _fusionSwizzle1.y;
                    _Result.z = _fusionSwizzle1.z;
                }

            _Result.a = _Render_Texture.a;

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

/* ####################################################### */

//@Begin_vertex
struct Projection {
    size: vec2f,
    scale: vec2f,
};

@group(0) @binding(0) var<uniform> projection: Projection;

struct VertexInput {
    @location(0) position: vec2f,
    @location(1) texCoord: vec2f,
    @location(2) color: vec4f,
    @location(3) ink: f32,
    @location(4) bgCoord: vec2f,
};

struct VertexOutput {
    @builtin(position) position: vec4f,
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
    @location(2) ink: f32,
    @location(3) bgCoord: vec2f,
};

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _X: f32,
    _Y: f32,
    _PosX: f32,
    _PosY: f32,
    parameter7_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

@vertex fn vs_main(input: VertexInput) -> VertexOutput {
    var output: VertexOutput;
    var Pos: vec3f = vec3f(input.position, 1.0);
        output.texCoord = (fusion.textureMatrix * Pos).xy;

        var _PixelSize: vec2f = vec2f(fusion.fPixelWidth, fusion.fPixelHeight);
        var _DirCorner: vec2f = sign(output.texCoord - 0.5);

                var _PivotMin: vec2f = vec2f(0.0, 0.0) - vec2f(params._PosX, params._PosY);
                var _PivotMax: vec2f = vec2f(1.0, 1.0) - vec2f(params._PosX, params._PosY);
                var _Pivot: vec2f = max(abs(_PivotMin), abs(_PivotMax));

            var _Expanded: vec2f = _Pivot * abs(vec2f(params._X, params._Y) * params._Mixing);
            var _PixelPadding: vec2f = _Expanded;
            var _PosExpanded: vec2f = input.position;

            {
                let _fusionSwizzle0 = _DirCorner * _PixelPadding;
                _PosExpanded.x += _fusionSwizzle0.x;
                _PosExpanded.y += _fusionSwizzle0.y;
            }

        var pos: vec3f = vec3f(_PosExpanded, 1.0);
        output.position = vec4f(fusion.projectionMatrix * fusion.transformMatrix * fusion.objectMatrix * pos, 1.0);

        output.texCoord = output.texCoord + _DirCorner * _Expanded;
    output.bgCoord = input.bgCoord;
    output.color = input.color;
    output.ink = input.ink;
    return output;
}
//@End

//@Begin_fragment

// Expanded source constant: RAD

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _X: f32,
    _Y: f32,
    _PosX: f32,
    _PosY: f32,
    parameter7_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_Render(_Tex: texture_2d<f32>, In: vec2f) -> vec4f {
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0) {
            return vec4f(0.0);
        }
        else {
            return texture2D(_Tex, In);
        }
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = Fun_Render(img, vec2f(input.texCoord)) * (input.color * fusion.blendColor);

        var _Pivot: vec4f;
        var _Shear: vec4f;
        {
            let _fusionSwizzle0 = input.texCoord - vec2f(params._PosX, params._PosY);
            _Pivot.x = _fusionSwizzle0.x;
            _Pivot.y = _fusionSwizzle0.y;
        }
        //_Pivot.zw = In.bgCoord - vec2(_PosX, _PosY);

        {
            let _fusionSwizzle1 = _Pivot.yx * vec2f(params._X, params._Y) * params._Mixing;
            _Shear.x = _fusionSwizzle1.x;
            _Shear.y = _fusionSwizzle1.y;
        }
        //_Shear.zw = _Pivot.wz * vec2(_X, _Y) * _Mixing;

            var _Result: vec4f = Fun_Render(img, vec2f(input.texCoord + _Shear.xy)) * (input.color * fusion.blendColor);

            if((params._Blending_Mode != 0)) {
                _Result = Fun_Render(background, vec2f(input.texCoord + _Shear.xy)) * vec4f(1.0, 1.0, 1.0, _Result.a);
            }

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

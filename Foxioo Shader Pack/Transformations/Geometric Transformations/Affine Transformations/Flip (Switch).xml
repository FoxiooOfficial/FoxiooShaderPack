<effect>
	<name>Flip (Switch)</name>
		<description>This effect allows you to flip the X and Y axes of texture separately.</description> 
			<author>Foxioo</author>
			<copyright>Copyright (C) 2024-2026 Foxioo</copyright>
			<website>https://github.com/FoxiooOfficial</website>
				<BackgroundTexture>1</BackgroundTexture>
				<dx8>1</dx8>
				<PSVersion>1.4</PSVersion>

		<sampler>
		    <index>0</index>
		    <filter>antialiasing</filter>
		    <addressU>wrap</addressU>
		    <addressV>wrap</addressV>
		</sampler>

		<sampler>
		    <index>1</index>
		    <filter>antialiasing</filter>
		    <addressU>wrap</addressU>
		    <addressV>wrap</addressV>
		</sampler>
		
		<parameter>
			<name>/* Foxioo's Flip (Switch) Shader | 2026.08.27 */</name>
			<property>checkbox</property>

			<variable>_</variable>

			<description>This effect allows you to flip the X and Y axes of texture separately.</description>
		</parameter>

			<parameter>
				<name>Blending Mode</name>
				<variable>_Blending_Mode</variable>

				<description>This variable determines what the base should be. Setting it to 1 sets the base as the texture of the object on which the effect is applied, and setting it to 0 sets this as the background.</description>

				<type>int</type>
				<property>checkbox</property>

				<value>0</value>
			</parameter>

			<parameter>
				<name>X</name>
				<variable>_X</variable>

				<description>Enables/disables flip for the X-Axis</description>

				<type>int</type>
				<property>checkbox</property>
				<value>1</value>
			</parameter>

			<parameter>
				<name>Y</name>
				<variable>_Y</variable>

				<description>Enables/disables flip for the Y-Axis</description>

				<type>int</type>
				<property>checkbox</property>
				<value>1</value>
			</parameter>

        <parameter>
            <name>/* */</name>
            <property>checkbox</property>
            <variable>__</variable>
        </parameter>


</effect>
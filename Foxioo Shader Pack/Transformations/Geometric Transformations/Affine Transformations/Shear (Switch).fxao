/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

uniform float _X;
uniform float _Y;
uniform float _PosY;
uniform float _PosX;
uniform float _Mixing;
uniform float fPixelWidth;
uniform float fPixelHeight;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
    In = texCoord;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

            vec2 _PivotMin = vec2(0.0, 0.0) - vec2(_PosX, _PosY);
            vec2 _PivotMax = vec2(1.0, 1.0) - vec2(_PosX, _PosY);
            vec2 _Pivot = max(abs(_PivotMin), abs(_PivotMax));

        vec2 _Expanded = _Pivot * abs(vec2(_X, _Y) * _Mixing);
        vec2 _PixelPadding = vec2(_Expanded);
        vec4 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding;

    gl_Position = projectionMatrix * transformMatrix * _PosExpanded;

    In = In + _DirCorner * _Expanded * _PixelSize;
}
//@End
/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

#define RAD 0.0174532925

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform vec4 blendColor;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _PosX;
uniform float _PosY;
uniform float _Mixing;
uniform bool _Blending_Mode;
uniform float _X;
uniform float _Y;

/************************************************************/
/* Main */
/************************************************************/

vec4 Fun_Render(sampler2D _Tex, vec2 In) {
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0)
        return vec4(0.0);
    else
        return texture2D(_Tex, In);
}

void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In) * blendColor;
   
    vec4 _Pivot, _Shear;
    _Pivot.xy = In - vec2(_PosX, _PosY);
    //_Pivot.zw = In.bgCoord - vec2(_PosX, _PosY);

    _Shear.xy = _Pivot.yx * vec2(_X, _Y) * _Mixing;
    //_Shear.zw = _Pivot.wz * vec2(_X, _Y) * _Mixing;

        vec4 _Result = Fun_Render(imgTexture, In + _Shear.xy) * blendColor;

        if(_Blending_Mode)
            _Result = Fun_Render(bckgTexture, In + _Shear.xy) * vec4(1.0, 1.0, 1.0, _Result.a);

    gl_FragColor = _Result;
}

//@End
/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

uniform float _Mixing;
uniform float _X;
uniform float _Y;
uniform float _PosY;
uniform float _PosX;
uniform float fPixelWidth;
uniform float fPixelHeight;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

        vec2 _Pivot = vec2(_PosX, _PosY);

        vec2 _Min = abs(vec2(0.0, 0.0) - _Pivot);
        vec2 _Max = abs(vec2(1.0, 1.0) - _Pivot);
        float _Rad = length(max(_Min, _Max));

        vec2 _Dist = vec2(-_Mixing, _Mixing) * vec2(_X, _Y)  * 0.35;

        vec2 _Expanded = (_Rad * 2.0) * abs(_Dist);
        vec2 _PixelPadding = _Expanded;
        vec2 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding;

    vec3 pos = vec3(_PosExpanded, 1.0);
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);

    In = In + _DirCorner * _Expanded;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

#define RAD 0.0174532925

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform vec4 blendColor;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _PosX;
uniform float _PosY;
uniform float _Mixing;
uniform bool _Blending_Mode;
uniform float _X;
uniform float _Y;

/************************************************************/
/* Main */
/************************************************************/

vec4 Fun_Render(sampler2D _Tex, vec2 In) {
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0)
        return vec4(0.0);
    else
        return texture(_Tex, In);
}

vec2 Fun_Squeeze(vec2 In)
{
    vec2 _Center = vec2(_PosX, _PosY);
    vec2 _Rel = In - _Center;
    float _Distance = length(_Rel);
    float _Theta = atan(_Rel.y, _Rel.x);

        vec2 _Dist = vec2(-_Mixing, _Mixing) * vec2(_X, _Y) * 0.35;

        vec2 _Squeeze = _Distance + (_Distance * _Dist * _Distance);
        vec2 UV = vec2(cos(_Theta), sin(_Theta)) * _Squeeze;

    return UV + _Center;
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In) * blendColor;

    vec2 UV = Fun_Squeeze(In);

        vec4 _Result = Fun_Render(imgTexture, UV) * blendColor;

        if(_Blending_Mode)
            _Result = Fun_Render(bckgTexture, UV) * vec4(1.0, 1.0, 1.0, _Result.a);

    fragColor = _Result;
}
//@End
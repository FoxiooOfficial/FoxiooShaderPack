/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

uniform float _TuneTail;
uniform float _TuneHead;
uniform float _Angle;
uniform float _PosY;
uniform float _PosX;
uniform float _Mixing;
uniform float fPixelWidth;
uniform float fPixelHeight;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
    In = texCoord;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

        vec2 _Pivot = vec2(_PosX, _PosY);
        _Pivot *= _Pivot;

        vec2 _Min = abs(vec2(0.0, 0.0) - _Pivot);
        vec2 _Max = abs(vec2(1.0, 1.0) - _Pivot);
        float _Rad = length(max(_Min, _Max));

            float _Tune = max(abs(_TuneTail), abs(_TuneHead));
            float _Ang = abs(radians(_Angle)) * _Tune;

        float _Expanded = _Rad * 2.0 * sin(min(_Ang * 0.5, 1.57079632));
        vec2 _PixelPadding = vec2(_Expanded);
        vec4 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding / _PixelSize;

    gl_Position = projectionMatrix * transformMatrix * _PosExpanded;

    In = In + _DirCorner * _Expanded;
}
//@End
/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

#define RAD 0.0174532925

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform vec4 blendColor;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _PosX;
uniform float _PosY;
uniform float _Mixing;
uniform bool _Blending_Mode;
uniform float _TuneTail;
uniform float _TuneHead;
uniform float _Angle;
uniform float _Start;

/************************************************************/
/* Main */
/************************************************************/

vec4 Fun_Render(sampler2D _Tex, vec2 In) {
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0)
        return vec4(0.0);
    else
        return texture2D(_Tex, In);
}

vec2 Fun_Bend(vec2 In)
{
    vec2 _Point = vec2(_PosX, _PosY);
    vec2 _Center = In - _Point;
    float _Distance = length(_Center);
    
        float _Blend = ((_Distance - _Start) / (1.0 - _Start));
        float _Factor = step(_Start, _Distance);

            float _Tune = mix(_TuneTail, mix(_TuneTail, _TuneHead, _Blend), _Factor);
            float _Ang = radians(_Angle) * _Tune;
            
        vec2 _Os = vec2(cos(_Ang), sin(_Ang));
        mat2 _Rot = mat2(_Os.x, _Os.y, -_Os.y, _Os.x);
    
    return _Rot * _Center + _Point;
}

void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In) * blendColor;

    vec2 UV = mix(In, Fun_Bend(In), _Mixing);

        vec4 _Result = Fun_Render(imgTexture, UV) * blendColor;

        if(_Blending_Mode)
            _Result = Fun_Render(bckgTexture, UV) * vec4(1.0, 1.0, 1.0, _Result.a);

    gl_FragColor = _Result;
}

//@End
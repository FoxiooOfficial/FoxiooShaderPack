/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

in vec2 position;
out vec2 In;
void main()
{
    vec3 pos = vec3(position, 1.0);
    In = (textureMatrix * pos).xy;
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

#define RAD 0.0174532925

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform vec4 blendColor;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _PosX;
uniform float _PosY;
uniform float _PosZ;

uniform float _OffsetX;

uniform float _ScaleX;
uniform float _ScaleY;
uniform float _Scale;

uniform float _RotX;
uniform float _RotY;
uniform float _RotZ;

uniform float _Distortion;

uniform float _RotXPointX;
uniform float _RotXPointY;
uniform float _RotYPointX;
uniform float _RotYPointY;

uniform float _PosOffsetX;
uniform float _PosOffsetY;

uniform int _Looping_Mode;

uniform bool _Render_Sky;
//uniform bool _Blending_Mode;

//uniform bool _Is_Pre_296_Build;

/***********************************************************/
/* Mode 7 */
/***********************************************************/

vec2 Fun_Mode7(vec2 In)
{
    /* THE REAL, M O D E  7  E F F E C T (the best function :3) */

        /* Perspective */
        vec2 _UV = In / (In.y * _Distortion - 0.5);

    return _UV * _PosZ;
}

vec2 Fun_Rotation(vec2 In, vec2 _Pivot, float _Mul, float _Off, float _Rot, float _RotSub)
{
    vec2 _UV = vec2(In.x + _Pivot.x, In.y + _Pivot.y) * _Mul;

    float _Rot_Temp = (_Rot - _RotSub) * RAD;

        float _CosR = cos(_Rot_Temp);
        float _SinR = sin(_Rot_Temp);

        vec2 _OffsetUV = _UV - _Off;

    return _Off + vec2(
        _OffsetUV.x * _CosR + _OffsetUV.y * _SinR,
        -_OffsetUV.x * _SinR + _OffsetUV.y * _CosR
    );

}

float Fun_Loop(float _UV, int _Mode)
{
    if(_Mode == 0)
        return fract(_UV);

    else if(_Mode == 1)
        return abs(fract(_UV / 2.0) * 2.0 - 1.0);

    else if(_Mode == 2)
        return clamp(_UV, 0.0, 1.0);

    else
        return _UV;
}

bool Fun_CheckEdge(float _UV, int _Mode) { return (_Mode == 3 && (_UV < 0.0 || _UV > 1.0)); }

ivec2 Fun_SetLoop(int _Looping)
{
    if(_Looping == 0)      return ivec2(0, 0);
    else if(_Looping == 1) return ivec2(1, 1);
    else if(_Looping == 2) return ivec2(2, 2);
    else if(_Looping == 3) return ivec2(3, 3);

    else if(_Looping == 4) return ivec2(1, 0);
    else if(_Looping == 5) return ivec2(2, 0);
    else if(_Looping == 6) return ivec2(3, 0);

    else if(_Looping == 7) return ivec2(0, 1);
    else if(_Looping == 8) return ivec2(2, 1);
    else if(_Looping == 9) return ivec2(3, 1);

    else if(_Looping == 10) return ivec2(0, 2);
    else if(_Looping == 11) return ivec2(1, 2);
    else if(_Looping == 12) return ivec2(3, 2);

    else if(_Looping == 13) return ivec2(0, 3);
    else if(_Looping == 14) return ivec2(1, 3);
    else if(_Looping == 15) return ivec2(2, 3);

    else return ivec2(2, 2);
}

/************************************************************/
/* Main */
/************************************************************/

out vec4 fragColor;
void main(void)
{   
    //vec2 In_Background = vec2(In.x, 1.0 - In.y);
    
    /* _RotY -> Rotation around the CENTER of the screen (camera viewpoint) */
    vec2 In_RotY;
    //if(_Is_Pre_296_Build && _Blending_Mode)
        //In_RotY = Fun_Rotation(In_Background, vec2(_RotYPointX, _RotYPointY), 1.0, 0.5, _RotY, 180.0);
    //else
        In_RotY = Fun_Rotation(In, vec2(_RotYPointX, _RotYPointY), 1.0, 0.5, _RotY, 180.0);

    /* _RotZ -> Y-axis offset of texCoords; */
    float _RotZ_Temp = _RotZ * RAD;

        //vec2 _In_Old = In_RotY;
        vec2 _In_Mod = In_RotY;

        _In_Mod.y += _RotZ_Temp;
        _In_Mod.x +=  _OffsetX - 0.5; /* ALSO OFFSET IN X AXIS RAHHHHHHH */

        /* Set Mode 7 Distortion! -> Set perspective depth OR orthographic projection!!! */
        /* TODO: add option to change the POV */
        vec2 _UV = Fun_Mode7(_In_Mod);
        
            /* _PosX -> Camera rotation AROUND ITSELF */
            _UV = Fun_Rotation(_UV, vec2(_RotXPointX, _RotXPointY), 0.5, 0.0, _RotX, 0.0);

            /* "Translation"
                (why is it called that? :sob:) ugh, whatever, change of position... wait
                these are points for scale!!!??
                AHHH WHY AM I EVEN COMMENTING ON THIS
            */
            /* +X; -Y */
            _UV += vec2(_PosOffsetX, -_PosOffsetY + 0.5);

            /* "Scale"
                Changing the scale of texCoords -> the closer to zero, the larger texture!
            */
            _UV *= vec2(_ScaleX, _ScaleY) * _Scale;

            /* "Translation" (but for real)
                The actual change in the "camera" position!!!
            */
            /* +X; -Y */
            _UV += vec2(_PosX, -_PosY) + vec2(0.5, 0.5);
        
            ivec2 _Mode;
            _Mode = Fun_SetLoop(_Looping_Mode);
            vec2 _In_Orginal = _UV;
            
            /* "Looping Mode"
                Specifies how the texture should loop
            */
                _UV = vec2(
                    Fun_Loop(_UV.x, _Mode.x),
                    Fun_Loop(_UV.y, _Mode.y)
                );

                if(Fun_CheckEdge(_In_Orginal.x, _Mode.x) || Fun_CheckEdge(_In_Orginal.y, _Mode.y))  discard;
            /* HEL YEA */
    
    /* Rendering */
    vec4 _Render_Texture = texture(imgTexture, _UV);
    //vec4 _Render_Background = texture(bckgTexture, _UV);

    //vec4 _Render = mix(_Render_Texture, vec4(_Render_Background.rgb, _Render_Texture.a), float(_Blending_Mode));
    vec4 _Render = _Render_Texture;
    
        /* REMOVE THE SKY WHEN *necessary*; 

        -> check if _PosZ is positive
        -> check if the ground render is greater than 0.5

            I tried using IF/ELSE, but main goal is to get this function working on D3D9 at all

            (i have to comment on this because the code is becoming less readable due to optimization :sob:)
        */
        _Render *= mix(vec4(abs(step(0.0, _PosZ) - step(0.5, _In_Mod.y * _Distortion))), vec4(1.0), float(_Render_Sky));

    fragColor = _Render;
}
//@End
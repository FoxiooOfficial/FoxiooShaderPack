/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    parameter3_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

/************************************************************/
/* Main */
/************************************************************/
fn Fun_FMod(_Value: f32, _Denom: f32) -> f32 {
    return _Value - _Denom * floor(_Value / _Denom);
}

fn Fun_Luminance(_Result: vec3f) -> f32 {
    const _Kr: f32 = 0.299;
        const _Kg: f32 = 0.587;
        const _Kb: f32 = 0.114;

        var _Y: f32 = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

        return _Y;
}

fn RGBtoHSL(_Render: vec3f) -> vec3f {
    var _CMax: f32 = max(_Render.r, max(_Render.g, _Render.b));
        var _CMin: f32 = min(_Render.r, min(_Render.g, _Render.b));
        var _Delta: f32 = _CMax - _CMin;

            var _H: f32 = 0.0;
            var _S: f32 = 0.0;
            var _L: f32 = (_CMax + _CMin) * 0.5;

        if (_Delta != 0.0)
        {
            _S = _Delta / (1.0 - abs(2.0 * _L - 1.0));

            if (_CMax == _Render.r)
            {
                _H = 60.0 * ((_Render.g - _Render.b) / _Delta);
            }
            else if (_CMax == _Render.g)
            {
                _H = 60.0 * ((_Render.b - _Render.r) / _Delta + 2.0);
            }
            else
            {
                _H = 60.0 * ((_Render.r - _Render.g) / _Delta + 4.0);
            }

            if (_H < 0.0) { _H += 360.0; }
        }

        return vec3f(_H, _S, _L);
}

fn HSLtoRGB(_H: f32, _S: f32, _L: f32) -> vec3f {
    var _C: f32 = (1.0 - abs(2.0 * _L - 1.0)) * _S;
        var _X: f32 = _C * (1.0 - abs((Fun_FMod(f32(_H / 60.0), f32(2.0))) - 1.0));
        var _M: f32 = _L - _C * 0.5;

        var _Render: vec3f = select(select(select(select(select(vec3f(_C, 0, _X), vec3f(_X, 0.0, _C), (_H < 300.0)), vec3f(0.0, _X, _C), (_H < 240.0)), vec3f(0.0, _C, _X), (_H < 180.0)), vec3f(_X, _C, 0.0), (_H < 120.0)), vec3f(_C, _X, 0.0), (_H < 60.0));

        return (_Render + _M);
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Result: vec4f = select(_Render_Texture, _Render_Background, (params._Blending_Mode != 0));
            var _Render: vec4f = _Result;

            const _HueTarget: f32 = 120.0;
            const _HueSize: f32 = 90.0;
            const _SaturationMin: f32 = 0.15;
            const _HueEnd: f32 = 357.0;
            const _HueEndAdd: f32 = 0.25;
            const _HueEndLift: f32 = 0.05;

                var _Fixed: vec3f = vec3f(0.0, 0.3, 0.0) * Fun_Luminance(vec3f(_Render.rgb));
                var _HSL: vec3f = RGBtoHSL(vec3f(clamp(_Render.rgb + _Fixed, vec3f(0.0), vec3f(1.0))));
                var _HSLEnd: vec3f = _HSL;

                    var _Diff: f32 = abs(_HSLEnd.x - _HueTarget);
                    _Diff = select(_Diff, 360.0 - _Diff, (_Diff > 180.0));

                    var _Mask: vec3f;
                    _Mask.x = smoothstep(0.0, 1.0, (1.0 - (_Diff / _HueSize)));
                    _Mask.y = smoothstep(_SaturationMin, _SaturationMin + 0.25, _Mask.x);

                var _Sum: vec3f = clamp(_Render.rgb + _Fixed, vec3f(0.0), vec3f(1.0));
                var _DiffEx: f32 = ((_Sum.g - max(_Sum.r, _Sum.b)) * 3.0);
                _Mask.z = _Mask.x * _Mask.y * _DiffEx;

                    var _HueOut: vec3f;
                    _HueOut.x = _HueEnd;
                    _HueOut.y = clamp(_HSLEnd.y + _HueEndAdd, 0.0, 1.0);
                    _HueOut.z = clamp(_HSLEnd.z + _HueEndLift, 0.0, 1.0);

                var _RenderHue: vec3f = HSLtoRGB(f32(_HueOut.x), f32(_HueOut.y), f32(_HueOut.z));

                {
                    let _fusionSwizzle0 = 1.2;
                    _RenderHue.x *= _fusionSwizzle0;
                    _RenderHue.z *= _fusionSwizzle0;
                }
                _RenderHue.g *= 0.8;

                {
                    let _fusionSwizzle1 = mix(_Render.rgb, _RenderHue, clamp(_Mask.z * params._Mixing, 0.0, 1.0));
                    _Result.x = _fusionSwizzle1.x;
                    _Result.y = _fusionSwizzle1.y;
                    _Result.z = _fusionSwizzle1.z;
                }
            _Result.a = _Render_Texture.a;

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

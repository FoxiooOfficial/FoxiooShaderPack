/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
float _Blending_Mode;

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts ************************************************/
            def c2, 0, 0, 0, -1;
            def c3, 0, 0, 0, 1;
            
            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                r1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r0, t0;
            texld r1, t1;

            /** Assembly ************************************************/
                mul r2.w, c1.x, c2.w;
                cmp r3.x, r2.w, r0.z, r1.z;
                cmp r3.y, r2.w, r0.y, r1.y;
                mul r4.w, c0.x, c2.w;
            + cmp r3.z, r2.w, r0.x, r1.x;
                mov r0.x, r0.w;
                mov r0.y, r4.w;

                phase;
                
                mov r1.w, r0.x;
                mov r0.w, r0.y;
                add r0.w, r0.w, c3.w;
            + mul r2.xyz, r3, c0.x;
                mad r4.x, r0.w, r3.z, r2.x;
                mad r4.y, r0.w, r3.y, r2.y;
                mov r4.w, r1.w;
            + mad r4.z, r0.w, r3.x, r2.z;
                mov r0, r4;
        };   
    }
}
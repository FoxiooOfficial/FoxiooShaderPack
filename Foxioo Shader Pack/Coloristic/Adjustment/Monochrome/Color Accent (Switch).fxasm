/***********************************************************/

/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

    float _Mixing;

    vector _Color;

    float _Blending_Mode;
    float _Invert;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Color>;          // c1
        PixelShaderConstant[2] = <_Blending_Mode>;  // c2
        PixelShaderConstant[3] = <_Invert>;         // c3
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c4, -1, -1, -1, -1;
            def c5, 0.298999995, 0.587000012, 0.114, 0;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r0, t0;
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r2.w, c2.x, c4.w;
                cmp r1.xyz, r2.w, r0, r1;
                mad r2.xyz, c1, c4, r1;
                dp3 r2.w, r2, r2;
                mul_sat r2.w, r2.w, c0.x;
                add r2.w, -r2.w, c3.x;
            + mov r0.x, r0.w;
                mov r0.y, r2.w;

                phase;

                mov r2.w, r0.x;
                mov r0.w, r0.y;
                cmp r0.w, r0.w, r0.w, -r0.w;
                dp3 r3.w, r1, c5;
                mul r3.w, r0.w, r3.w;
                mov r2.w, r2.w;
            + mad r2.xyz, r1, 1-r0.w, r3.w;
                mov r0, r2;
        };
    }
}
/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform vec4 _Color;
uniform vec4 _ColorShadow;
uniform bool _Blending_Mode;

/************************************************************/
/* Main */
/************************************************************/

float Fun_Luminance(vec3 _Result)
{
    const float _Kr = 0.299;
    const float _Kg = 0.587;
    const float _Kb = 0.114;

    float _Y = _Kr * _Result.r + _Kg * _Result.g + _Kb * _Result.b;

    return _Y;
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result;
        _Result.rgb = mix(_Render_Texture.rgb, _Render_Background.rgb, float(_Blending_Mode));
        _Result.a = _Render_Texture.a;

            float _Lum = dot(_Result.rgb, vec3(0.299, 0.587, 0.114));

            vec3 _Render = mix(_ColorShadow.rgb, _Color.rgb, _Lum);
            _Render = mix(_Render, vec3(1.0), _Lum);
    
        _Result.rgb = mix(_Result.rgb, _Render, _Mixing);

    gl_FragColor = _Result;
}

//@End

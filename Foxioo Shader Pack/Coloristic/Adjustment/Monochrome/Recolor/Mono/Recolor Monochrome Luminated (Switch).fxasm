/***********************************************************/

/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
vector _Color;
vector _ColorShadow;
float _Blending_Mode;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Color>;          // c1
        PixelShaderConstant[2] = <_ColorShadow>;    // c2
        PixelShaderConstant[3] = <_Blending_Mode>;  // c3
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c3, 0.298999995, 0.587000012, 0.114, -1;
            def c4, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r0.w, c2.x, c3.w;
                mul r2.w, c0.x, c3.w;
                add r2.w, r2.w, c4.w;
            + mov r2.x, r0.w;
                mov r2.y, r2.w;
                
                phase;
                
                texld r0, t0;
                mov r3.w, r2.x;
                mov r2.w, r2.y;
            + cmp r1.xyz, r3.w, r0, r1;
                dp3 r3.w, r1, c3;
                add r4.w, -r3.w, c4.w;
            + mul r5.xyz, r3.w, c1;
                mad r3.xyz, r4.w, r5, r3.w;
                mul r1.xyz, r1, r2.w;
            + mov r0.w, r0.w;
                mad r0.xyz, r3, c0.x, r1;
        };
    }
}
/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

    float _Mixing;

    dword _Blending_Mode;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts **************************************************/
            def c2, 0.333333343, 0.333333343, 0.333333343, -1;
            def c3, 0, 0, 0, 1;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                t1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r1, t1;
            
            /** Assembly ************************************************/

                mul r0.w, c1.x, c2.w;
                mul r2.w, c0.x, c2.w;
                add r2.w, r2.w, c3.w;
            + mov r2.x, r0.w;
                mov r2.y, r2.w;

                phase;

                texld r0, t0;
                mov r3.w, r2.x;
                mov r2.w, r2.y;
            + cmp r1.xyz, r3.w, r0, r1;
                add r3.w, r1.y, r1.x;
                add r3.w, r1.z, r3.w;
                mul r3.w, r3.w, c0.x;
            + mul r1.xyz, r1, r2.w;
                mov r0.w, r0.w;
            + mad r0.xyz, r3.w, c2, r1;
        };
    }
}
/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;
@group(3) @binding(0) var background: texture_2d<f32>;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}

//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Blending_Mode: i32,
    _Mixing: f32,
    _Time: f32,
    parameter4_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

const _Blend_0: vec3f = vec3f(0.2, 0.3, 0.4);
const _Blend_1: vec3f = vec3f(0.8, 0.5, 0.2);
const _Blend_2: vec3f = vec3f(1.0, 0.8, 0.6);
const _Blend_3: vec3f = vec3f(1.0, 1.0, 1.0);
const _Blend_4: vec3f = vec3f(1.0, 0.9, 0.8);
const _Blend_5: vec3f = vec3f(0.8, 0.4, 0.2);

/************************************************************/
/* Main */
/************************************************************/
fn Fun_FMod(_Value: f32, _Denom: f32) -> f32 {
    return _Value - _Denom * floor(_Value / _Denom);
}
struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);
        var _Render_Background: vec4f = texture2D(background, input.texCoord);

            var _Result: vec4f;
            var _Render: vec4f;

                if (!(params._Blending_Mode != 0)) {
                    _Render = _Render_Texture;
                    _Result = _Render_Texture;
                }
                else {
                    _Render = _Render_Background;
                    _Result = _Render_Background;
                }

                    var _TimeFix: f32 = Fun_FMod(f32(params._Time), f32(24.0));
                    if (_TimeFix < 0.0) { _TimeFix = 24.0 - abs(_TimeFix); }

                        if (_TimeFix < 4.0) {
                            {
                                let _fusionSwizzle0 = mix(_Blend_0, _Blend_1, _TimeFix / 4.0);
                                _Render.x *= _fusionSwizzle0.x;
                                _Render.y *= _fusionSwizzle0.y;
                                _Render.z *= _fusionSwizzle0.z;
                            }
                        }

                        else if (_TimeFix < 6.0) {
                            {
                                let _fusionSwizzle1 = mix(_Blend_1, _Blend_2, (_TimeFix - 4.0) / 2.0);
                                _Render.x *= _fusionSwizzle1.x;
                                _Render.y *= _fusionSwizzle1.y;
                                _Render.z *= _fusionSwizzle1.z;
                            }
                        }

                        else if (_TimeFix < 12.0) {
                            {
                                let _fusionSwizzle2 = mix(_Blend_2, _Blend_3, (_TimeFix - 6.0) / 6.0);
                                _Render.x *= _fusionSwizzle2.x;
                                _Render.y *= _fusionSwizzle2.y;
                                _Render.z *= _fusionSwizzle2.z;
                            }
                        }

                        else if (_TimeFix < 16.0) {
                            {
                                let _fusionSwizzle3 = mix(_Blend_3, _Blend_4, (_TimeFix - 12.0) / 4.0);
                                _Render.x *= _fusionSwizzle3.x;
                                _Render.y *= _fusionSwizzle3.y;
                                _Render.z *= _fusionSwizzle3.z;
                            }
                        }

                        else if (_TimeFix < 18.0) {
                            {
                                let _fusionSwizzle4 = mix(_Blend_4, _Blend_5, (_TimeFix - 16.0) / 2.0);
                                _Render.x *= _fusionSwizzle4.x;
                                _Render.y *= _fusionSwizzle4.y;
                                _Render.z *= _fusionSwizzle4.z;
                            }
                        }

                        else {
                            {
                                let _fusionSwizzle5 = mix(_Blend_5, _Blend_0, (_TimeFix - 18.0) / 6.0);
                                _Render.x *= _fusionSwizzle5.x;
                                _Render.y *= _fusionSwizzle5.y;
                                _Render.z *= _fusionSwizzle5.z;
                            }
                        }

                {
                    let _fusionSwizzle6 = mix(_Result.rgb, _Render.rgb, params._Mixing);
                    _Result.x = _fusionSwizzle6.x;
                    _Result.y = _fusionSwizzle6.y;
                    _Result.z = _fusionSwizzle6.z;
                }

            _Result.a = _Render_Texture.a;

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

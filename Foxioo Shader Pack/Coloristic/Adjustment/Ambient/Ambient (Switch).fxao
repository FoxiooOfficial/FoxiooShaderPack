/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform bool _Blending_Mode;
uniform float _Time;
uniform float _Mixing;
uniform bool _Is_Pre_296_Build;
uniform float _Add;
uniform float _Mul;
uniform float _Exposure; 
uniform float _Contrast;
uniform float _Saturation;
uniform float _Vibrance;
uniform float _Power;
uniform float _Bloom;
uniform float _BloomThreshold;
uniform float _Temperature;
uniform vec4 _AddColor;
uniform vec4 _MulColor;

const vec3 _Blend_0 = vec3(0.2, 0.3, 0.4);
const vec3 _Blend_1 = vec3(0.8, 0.5, 0.2);
const vec3 _Blend_2 = vec3(1.0, 0.8, 0.6);
const vec3 _Blend_3 = vec3(1.0, 1.0, 1.0);
const vec3 _Blend_4 = vec3(1.0, 0.9, 0.8);
const vec3 _Blend_5 = vec3(0.8, 0.4, 0.2);

/************************************************************/
/* Main */
/************************************************************/

vec3 Fun_Saturation(vec3 _Color, float _Sat)
{
    float _Lum = dot(_Color, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(_Lum), _Color, _Sat);
}

vec3 Fun_Vibrance(vec3 _Color, float _Vib)
{
    float _Max = max(_Color.r, max(_Color.g, _Color.b));
    float _Min = min(_Color.r, min(_Color.g, _Color.b));
    
        float _Sat = _Max - _Min;
    
        vec3 _Lum = _Color * vec3(0.2126, 0.7152, 0.0722);
        vec3 _Coeff = vec3(1.0 - _Vib * _Sat);

    return mix(_Lum, _Color, _Coeff);
}

vec3 Fun_Bloom(vec3 _Color, float _Intensity, float _Threshold)
{
    float brightness = dot(_Color, vec3(0.2126, 0.7152, 0.0722));
    float _BLOOM = max(0.0, brightness - _Threshold);

    return _Color + _BLOOM * _Intensity;
}

float Fun_FMod(float _Value, float _Denom)
{
    return _Value - _Denom * floor(_Value / _Denom);
}

void main(void)
{
    vec2 In_Background = In;
    if(_Is_Pre_296_Build) In_Background.y = 1.0 - In_Background.y;

    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background =texture2D(bckgTexture, In_Background);

        vec4 _Result, _Render;

            if (!_Blending_Mode) {   
                _Render = _Render_Texture; 
                _Result = _Render_Texture;
            }
            else {
                _Render = _Render_Background; 
                _Result = _Render_Background;
            }

                float _TimeFix = Fun_FMod(_Time, 24.0);
                if (_TimeFix < 0.0) _TimeFix = 24.0 - abs(_TimeFix);

                    if (_TimeFix < 4.0)
                        _Render.rgb *= mix(_Blend_0, _Blend_1, _TimeFix / 4.0);

                    else if (_TimeFix < 6.0)
                        _Render.rgb *= mix(_Blend_1, _Blend_2, (_TimeFix - 4.0) / 2.0);

                    else if (_TimeFix < 12.0)
                        _Render.rgb *= mix(_Blend_2, _Blend_3, (_TimeFix - 6.0) / 6.0);

                    else if (_TimeFix < 16.0)
                        _Render.rgb *= mix(_Blend_3, _Blend_4, (_TimeFix - 12.0) / 4.0);

                    else if (_TimeFix < 18.0)
                        _Render.rgb *= mix(_Blend_4, _Blend_5, (_TimeFix - 16.0) / 2.0);

                    else
                        _Render.rgb *= mix(_Blend_5, _Blend_0, (_TimeFix - 18.0) / 6.0);

            /* Temperature */
                _Render.r = _Render.r + (_Temperature / 273.15);
                _Render.g = _Render.g + (_Temperature / 273.15) / 2.0;
                _Render.b = _Render.b;

            /* Ambient */
                _Render.rgb += _AddColor.rgb * _Add;
                _Render.rgb *= mix(vec3(1.0), _MulColor.rgb, _Mul);

                _Render.rgb *= _Exposure / 100.0; 
                _Render.rgb = (_Render.rgb - 0.5) * (_Contrast / 100.0) + 0.5;
                _Render.rgb = Fun_Saturation(_Render.rgb, _Saturation / 100.0);
                _Render.rgb = Fun_Vibrance(_Render.rgb, _Vibrance / 100.0);

                _Render.rgb = Fun_Bloom(_Render.rgb, _Bloom, _BloomThreshold);

            _Result.rgb = mix(_Result.rgb, pow(abs(_Render.rgb), vec3(_Power)), _Mixing);

        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End
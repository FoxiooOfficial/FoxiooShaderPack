/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform bool _Blending_Mode;
uniform float _Mixing;
uniform float _Hue;
uniform float _Saturation;
uniform float _Intensity;

/************************************************************/
/* Main */
/************************************************************/

#define RAD 180.0 / 3.14159265

#define DEG_60 1.04719755
#define DEG_120 2.09439510
#define DEG_240 4.18879020
#define DEG 3.14159265 / 180.0

vec3 RGBtoHSI(vec3 _Render)
{
    float _R = _Render.r;
    float _G = _Render.g;
    float _B = _Render.b;

    float _I = (_R + _G + _B) / 3.0;
    float _S = 0.0;
    float _H = 0.0;

    if (_I > 0.0)
    {
        float _CMin = min(_R, min(_G, _B));
        _S = 1.0 - (_CMin / _I);
    }

        float _Num = 0.5 * ((_R - _G) + (_R - _B));
        float _Den = sqrt((_R - _G) * (_R - _G) + (_R - _B) * (_G - _B)) + 1e-6;
        float _Theta = acos(clamp(_Num / _Den, -1.0, 1.0)) * (RAD);

        if (_B > _G)
            _H = 360.0 - _Theta;
        else
            _H = _Theta;

    return vec3(_H, _S, _I);
}

vec3 HSItoRGB(float _H, float _S, float _I)
{
    float _R, _G, _B;

    _H = mod(_H, 360.0);
    if (_H < 0.0) _H += 360.0;
    
    float _Rad = _H * DEG;
        
        if (_H < 120.0)
        {
            _B = _I * (1.0 - _S);
            _R = _I * (1.0 + (_S * cos(_Rad)) / cos(DEG_60 - _Rad));
            _G = 3.0 * _I - (_R + _B);
        }
        else if (_H < 240.0)
        {
            _Rad -= DEG_120;
            _R = _I * (1.0 - _S);
            _G = _I * (1.0 + (_S * cos(_Rad)) / cos(DEG_60 - _Rad));
            _B = 3.0 * _I - (_R + _G);
        }
        else
        {
            _Rad -= DEG_240;
            _G = _I * (1.0 - _S);
            _B = _I * (1.0 + (_S * cos(_Rad)) / cos(DEG_60- _Rad));
            _R = 3.0 * _I - (_G + _B);
        }

    return clamp(vec3(_R, _G, _B), 0.0, 1.0);
}

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Render = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec4 _Result = _Render;

            vec3 _HSI = RGBtoHSI(_Render.rgb);

                _HSI.x = mod(_HSI.x + _Hue, 360.0);
                    if (_HSI.x < 0.0) _HSI.x += 360.0;
        
                _HSI.y = (_HSI.y * (_Saturation / 50.0));
                _HSI.z = (_HSI.z + (_Intensity - 50.0) / 50.0);

            _Result.rgb = HSItoRGB(_HSI.x, _HSI.y, _HSI.z);

        _Result.rgb = mix(_Render.rgb, _Result.rgb, _Mixing);
        _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End

/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
float _Blending_Mode;

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1
        
        PixelShader = asm
        {
            ps.1.4;
            
            /** Consts ************************************************/
            def c2, 0, 0, 0, -1;
            def c3, 1, 1, 1, 1;
            
            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                r1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);
            */
            texld r0, t0;
            texld r1, t1;
            

                mul r2.w, c1.x, c2.w;
                cmp r1.xyz, r2.w, r0, r1;
            + mul r2.w, c0.x, c2.w;
                add r3.xyz, -r1, c3;
            + add r2.w, r2.w, c3.w;
                mul r3.xyz, r3, c0.x;
            + mov r0.w, r0.w;
                mad r0.xyz, r2.w, r1, r3;
        };   
    }
}
/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform bool _Blending_Mode;

/************************************************************/
/* Main */
/************************************************************/

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In);

        vec4 _Result = _Blending_Mode ? _Render_Background : _Render_Texture;
        vec4 _Render = _Result;

            _Result.rgb *= vec3(0.02, 0.01, 0.5);
            _Result.r = mix(0.0, 1.0, _Result.b / 2.0);

                vec3 _ColorRed = vec3(1.0, 0.2, 0.5);
                    _Result.r += mix(0.0, _ColorRed.r, (_Render.r - 0.75) / (1.0 - 0.75));

                vec3 _ColorGreen = vec3(0.6, 1.0, 0.1);
                    _Result.g += mix(0.0, _ColorGreen.g, (_Render.g - 0.75) / (1.0 - 0.75));

                vec3 _ColorBlue = vec3(0.2, 1.0, 0.8);
                    _Result.b += mix(0.0, _ColorBlue.b, (_Render.b - 0.75) / (1.0 - 0.75));

                _Result.rgb = pow(abs(_Result.rgb), 1.0 / vec3(2.2)); 

            _Result = mix(_Render, _Result, _Mixing);
            _Result.a = _Render_Texture.a;

    gl_FragColor = _Result;
}

//@End
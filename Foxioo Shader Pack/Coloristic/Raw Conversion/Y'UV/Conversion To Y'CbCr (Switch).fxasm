/* ####################################################### */

/***********************************************************/
/* Samplers */
/***********************************************************/

texture T_Image;
texture T_Background;

/***********************************************************/
/* Variables */
/***********************************************************/

    float _Mixing;

    dword _Blending_Mode;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        Texture[2] = <T_Background>;                // sampler2D S2D_Background : register(s1);
        MinFilter[2] = LINEAR;
        MagFilter[2] = LINEAR;
        MipFilter[2] = LINEAR;
        AddressU[2] = WRAP;
        AddressV[2] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_Blending_Mode>;  // c1

        PixelShader = asm
        {
            ps.1.4

            /** Consts ************************************************/
            def c2, 0.298999995, -0.168735996, 0.5, -1
            def c3, 0.587000012, -0.331263989, -0.418687999, -1
            def c4, 0.114, 0.5, -0.0813120008, 1

            /** Samplers ************************************************/
            /*
                r0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
                r1 -> float4 _Render_Background = tex2D(S2D_Background, In_Background);

                t0 -> float2 In : TEXCOORD0;
            */
            texld r0, t0
            texld r1, t0


            mul r2.w, c1.x, c2.w
            cmp r1.xyz, r2.w, r0, r1
            mov r0.x, r0.w
            phase
            mov r0.w, r0.x
            + dp3 r2.x, r1, c2
            dp3 r2.y, r1, c3
            + mul r3.w, c0.x, c3.w
            dp3 r2.z, r1, c4
            + add r3.w, r3.w, c4.w
            mul r1.xyz, r1, r3.w
            + mov r0.w, r0.w
            mad r0.xyz, r2, c0.x, r1
        };
    }
}

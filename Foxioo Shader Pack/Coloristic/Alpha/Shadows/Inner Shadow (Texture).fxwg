/* ####################################################### */

//@Begin_fragment

/***********************************************************/
/* Samplers */
/***********************************************************/

@group(1) @binding(0) var img: texture_2d<f32>;
@group(1) @binding(1) var textureSampler: sampler;

fn texture2D(image: texture_2d<f32>, texCoord: vec2f) -> vec4f {
    return textureSampleLevel(image, textureSampler, texCoord, 0.0);
}
//uniform sampler2D bckgTexture;

/***********************************************************/
/* Variables */
/***********************************************************/

struct Params {
    parameter0_value: i32,
    _Mixing: f32,
    _PosX: f32,
    _PosY: f32,
    _Size: f32,
    _Color: vec4f,
    _ColorAccent: vec4f,
    _ColorAlpha: f32,
    _AlphaMul: f32,
    _AlphaBack: f32,
    parameter10_value: i32,
};

@group(2) @binding(1) var<uniform> params: Params;

const _Samples: i32 = 16;

/************************************************************/
/* Main */
/************************************************************/

struct FragmentInput {
    @location(0) texCoord: vec2f,
    @location(1) color: vec4f,
};
@fragment fn fs_main(input: FragmentInput) -> @location(0) vec4f {
    var _fusionOutput: vec4f = vec4f(0.0);
    var _Render_Texture: vec4f = texture2D(img, input.texCoord) * (input.color * fusion.blendColor);

        var _Alpha: f32 = 0.0;
        for (var y: i32 = 0; y <= _Samples; y += 1)
        {
            for (var x: i32 = 0; x <= _Samples; x += 1)
            {
                var _Offset: vec2f = (vec2f(f32(x), f32(y)) / f32(_Samples) - 0.5) * params._Size;

                _Offset = vec2f(fusion.fPixelWidth, fusion.fPixelHeight) * (_Offset + vec2f(params._PosX, params._PosY));
                _Alpha += texture2D(img, input.texCoord + _Offset).a;
            }
        }

        _Alpha /= f32(_Samples * _Samples);

        //float _Outer = clamp(_Alpha * _AlphaMul, 0.0, 1.0) * (1.0 - _Render_Texture.a);
        var _Inner: f32 = clamp((1.0 - _Alpha) * params._AlphaMul, 0.0, 1.0) * _Render_Texture.a;

            var _Strength: f32 = clamp(_Inner, 0.0, 1.0);
            var _Mask: f32 = clamp((1.0 - _Render_Texture.a) + params._AlphaBack, 0.0, 1.0);

            var _Render_Color: vec4f = mix(params._ColorAccent, params._Color, _Strength);
            _Render_Color.a = _Strength * _Mask * params._ColorAlpha * params._Mixing;

                var _Render: vec4f = _Render_Texture;
                _Render.a *= params._AlphaBack;

                var _Result: vec4f;

            _Result.a = _Render_Color.a + _Render.a * (1.0 - _Render_Color.a);
            {
                let _fusionSwizzle0 = mix(_Render.rgb, _Render_Color.rgb, _Render_Color.a / _Result.a);
                _Result.x = _fusionSwizzle0.x;
                _Result.y = _fusionSwizzle0.y;
                _Result.z = _fusionSwizzle0.z;
            }

        _fusionOutput = _Result;
    return _fusionOutput;
}
//@End

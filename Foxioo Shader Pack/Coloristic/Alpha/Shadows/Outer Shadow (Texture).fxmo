/* ####################################################### */

//@Begin_vertex
//version_####

uniform mat3 transformMatrix;
uniform mat3 projectionMatrix;
uniform mat3 objectMatrix;
uniform mat3 textureMatrix;

uniform float _Size;
uniform float _PosX;
uniform float _PosY;
uniform float fPixelWidth;
uniform float fPixelHeight;

in vec2 position;
out vec2 In;
void main()
{
    vec3 Pos = vec3(position, 1.0);
    In = (textureMatrix * Pos).xy;

    vec2 _PixelSize = vec2(fPixelWidth, fPixelHeight);
    vec2 _DirCorner = sign(In - 0.5);

        float _Expanded = abs(max(_PosX + 1.0, _PosY + 1.0) * _Size);
        vec2 _PixelPadding = vec2(_Expanded);
        vec2 _PosExpanded = position;

        _PosExpanded.xy += _DirCorner * _PixelPadding;

    vec3 pos = vec3(_PosExpanded, 1.0);
    gl_Position = vec4(projectionMatrix * transformMatrix * objectMatrix * pos, 1.0);

    In = In + _DirCorner * _Expanded;
}
//@End

/* ####################################################### */

//@Begin_fragment
//version_####

#ifdef GL_ES
    #if defined(GL_FRAGMENT_PRECISION_HIGH)
        #define HIGH_PRECISION_SUPPORTED
    #endif
#else
    #define HIGH_PRECISION_SUPPORTED    
#endif

#ifdef HIGH_PRECISION_SUPPORTED
    precision highp float;
#else
    precision mediump float;
#endif

in vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
// uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;
uniform vec4 _Color;
uniform vec4 _ColorAccent;
uniform float _Size;
uniform float _PosX;
uniform float _PosY;
uniform float _ColorAlpha;
uniform float _AlphaMul;
uniform float _AlphaBack;

/************************************************************/
/* Main */
/************************************************************/

const int _Samples = 16;

vec4 Fun_Render(sampler2D _Tex, vec2 In)
{
    if(In.x <= 0.0 || In.y <= 0.0 || In.x >= 1.0 || In.y >= 1.0)
        return vec4(0.0);
    else
        return texture(_Tex, In);
}

out vec4 fragColor;
void main(void)
{
    vec4 _Render_Texture = Fun_Render(imgTexture, In) * blendColor;

    float _Alpha = 0.0;
    for(int y = 0; y <= _Samples; y++)
    {
        for(int x = 0; x <= _Samples; x++)
        {
            vec2 _Offset = (vec2(float(x), float(y)) / float(_Samples) - 0.5) * _Size;
            
            _Offset = vec2(fPixelWidth, fPixelHeight) * (_Offset + vec2(_PosX, _PosY));
            _Alpha += Fun_Render(imgTexture, In + _Offset).a;
        }
    }
    
    _Alpha /= float(_Samples * _Samples);

    float _Outer = clamp(_Alpha * _AlphaMul, 0.0, 1.0) * (1.0 - _Render_Texture.a);
    //float _Inner = clamp((1.0 - _Alpha) * _AlphaMul, 0.0, 1.0) * _Render_Texture.a;

        float _Strength = clamp(_Outer, 0.0, 1.0);
        float _Mask = clamp((1.0 - _Render_Texture.a) + _AlphaBack, 0.0, 1.0);

        vec4 _Render_Color = mix(_ColorAccent, _Color, _Strength);
        _Render_Color.a = _Strength * _Mask * _ColorAlpha * _Mixing;

            vec4 _Render = _Render_Texture;
            _Render.a *= _AlphaBack;

            vec4 _Result;

        _Result.a = _Render_Color.a + _Render.a * (1.0 - _Render_Color.a);
        _Result.rgb = mix(_Render.rgb, _Render_Color.rgb, _Render_Color.a / _Result.a);
        
    fragColor = _Result;
}
//@End
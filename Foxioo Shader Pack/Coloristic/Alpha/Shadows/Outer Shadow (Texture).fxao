/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Varibles */
/***********************************************************/

uniform float _Mixing;
uniform float _Size;
uniform float _PosX;
uniform float _PosY;

uniform float _AlphaMul;
uniform float _AlphaBack;
uniform float _ColorAlpha;

uniform vec4 _Color;
uniform vec4 _ColorAccent;

const int _Samples = 16;

/************************************************************/
/* Main */
/************************************************************/

void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;

    float _Alpha = 0.0, _Idx = 0.0;

    for(int y = 0; y <= _Samples; y++)
    {
        for(int x = 0; x <= _Samples; x++)
        {
            vec2 _Offset = (vec2(x, y) / float(_Samples) - 0.5) * _Size;
            
            _Offset = vec2(fPixelWidth, fPixelHeight) * (_Offset + vec2(_PosX, _PosY));
            
            _Alpha += texture2D(imgTexture, In + _Offset).a * blendColor.a;
            _Idx += 1.0;
        }
    }
    
    _Alpha /= _Idx;

        float _OuterMask = (1.0 - _Render_Texture.a) * _Alpha;
    
        _OuterMask = clamp(_OuterMask * _AlphaMul, 0.0, 1.0);

            vec4 _OutlineColor = mix(_ColorAccent, _Color, _OuterMask);
            _OutlineColor.a = (1.0 - _Render_Texture.a) * _ColorAlpha;

        vec4 _Render = _Render_Texture;
        _Render.a *= _AlphaBack;

        _Render = mix(_Render, _OutlineColor, _OuterMask * _Mixing);

    gl_FragColor = _Render;
}

//@End

/* ####################################################### */

/***********************************************************/
/* Samplers */
/***********************************************************/

texture T_Image;

/***********************************************************/
/* Varibles */
/***********************************************************/

    float _Mixing;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;

        PixelShader = asm
        {
            ps.1.1

            /** Consts ************************************************/
            def c1, 1, 0, 0, -1
            def c2, 0, 0, 0, 0.5
            def c3, 0, 0, 0, 1
            def c4, 0, 0, 0, 0

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, TEXCOORD0);
            */
            tex t0

            
            mad r0.w, -t0.w, c1.w, c2.w
            cnd r1.w, r0.w, c3.w, c4.w
            dp3 t1, c1, c0
            mul t1.w, t1.w, c1.w
            + mov r1.xyz, t0
            add t1.w, t1.w, c3.w
            mul t0, t0, t1.w
            dp3 t1, c1, c0
            mad r0, r1, t1, t0
        };
    }
}

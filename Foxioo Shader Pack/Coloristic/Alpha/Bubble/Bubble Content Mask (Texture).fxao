/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
uniform float fPixelWidth;
uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _Mixing;

uniform vec4 _ColorIn;
uniform vec4 _ColorBackground;
uniform vec4 _OutlineColor;

uniform float _OutlineAlpha;
uniform float _OutlineOffset;

uniform bool _OutlineCorner;



#define _SIZE 1

/************************************************************/
/* Main */
/************************************************************/

void main(void)
{   
    vec2 In_Background = In;
    if(_Is_Pre_296_Build) In_Background = vec2(In.x, 1.0 - In.y);

    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;
    vec4 _Render_Background = texture2D(bckgTexture, In_Background);

    vec4 _Result;
    float _Inside;
    if(_Render_Background.r == _ColorIn.r && _Render_Background.g == _ColorIn.g && _Render_Background.b == _ColorIn.b)
    {   
        /* inside */
        _Result.rgb = _Render_Texture.rgb;
        _Result.a = 1.0;
        _Inside = 1.0;

        _Result.rgb = mix(_ColorBackground.rgb, _Render_Texture.rgb, _Render_Texture.a);
    }
    else
    {   
        /* outside!!! */
        _Result = vec4(0.0, 0.0, 0.0, 0.0);
        _Inside = 0.0;
    }

    /* outline !! */
    float _Outline = 0.0;
    for(int y = -_SIZE; y <= _SIZE; y++)
    {
        for(int x = -_SIZE; x <= _SIZE; x++)
        {
            bool _Test = (x == 0) != (y == 0);
            bool _Include = _OutlineCorner ? true : _Test;

            if (_Include)
            {
                vec2 _Off = vec2(fPixelWidth, fPixelHeight) * vec2(float(x), float(y)) * _OutlineOffset;
                float _Comp = 0.0;

                vec3 _Color = texture2D(bckgTexture, In_Background + _Off).rgb;
                if(_Color.r == _ColorIn.r && _Color.g == _ColorIn.g && _Color.b == _ColorIn.b);
                    _Comp = 1.0;

                _Outline += _Comp;
            }
        }
    }

    _Outline = clamp(_Outline, 0.0, 1.0);
    _Inside = clamp(_Inside, 0.0, 1.0);

        _Result = mix(vec4(_OutlineColor.rgb, _OutlineAlpha), _Result, 1.0 - (_Outline - _Inside));

    gl_FragColor = _Result;
}

//@End

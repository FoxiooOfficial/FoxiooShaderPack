/* ####################################################### */

//@Begin_vertex

#ifdef GL_ES
 precision mediump float;
#endif
uniform mat4 transformMatrix;
uniform mat4 projectionMatrix;

attribute vec4 position;
attribute vec2 texCoord;
varying vec2 In;

void main(void)
{
	In = texCoord;
	gl_Position = projectionMatrix * transformMatrix * position;
}

//@End

/* ####################################################### */

//@Begin_fragment

#ifdef GL_ES
 precision mediump float;
#endif

varying vec2 In;

/***********************************************************/
/* Samplers */
/***********************************************************/

uniform sampler2D imgTexture;
//uniform sampler2D bckgTexture;

uniform lowp vec4 blendColor;
//uniform float fPixelWidth;
//uniform float fPixelHeight;

/***********************************************************/
/* Variables */
/***********************************************************/

uniform float _PosX;
uniform float _PosY;

uniform float _RotX;

uniform float _PointX;
uniform float _PointY;

uniform float _Scale;
uniform float _ScaleX;
uniform float _ScaleY;

uniform int _Looping_Mode;
uniform float _Mixing;
uniform bool _Overlay;

uniform sampler2D _Texture;


/************************************************************/
/* Main */
/************************************************************/

vec2 Fun_RotationX(vec2 In)
{
    vec2 _Points = vec2(_PointX, _PointY);
    float _RotX_Fix = radians(_RotX);

        float _Sin = sin(_RotX_Fix);
        float _Cos = cos(_RotX_Fix);

    return _Points + mat2(_Cos, _Sin, -_Sin, _Cos) * (In - _Points);
}
void main(void)
{
    vec4 _Render_Texture = texture2D(imgTexture, In) * blendColor;

    vec2 _Pos = vec2(_PosX, _PosY);
    vec2 _Point = vec2(_PointX, _PointY);
    vec2 _ScaleEx = vec2(_ScaleX, _ScaleY) * _Scale;

            vec2  UV = Fun_RotationX((In + _Pos));
            UV = ((UV - _Point) * _ScaleEx) + _Point;

                /* Looping Mode! */
                if (_Looping_Mode == 0)     UV = fract(UV); // REPEAT
                else if(_Looping_Mode == 1) UV = 1.0 - abs(fract(UV / 2.0) * 2.0 - 1.0); // MIRRORED REPEAT
                else if(_Looping_Mode == 2) UV = clamp(UV, 0.0, 1.0); // CLAMP
                else                        UV *= 1.0 - float(UV.x <= 0.0 || UV.x >= 1.0 || UV.y <= 0.0 || UV.y >= 1.0); // BORDER

            vec4 _Result = _Render_Texture;
            vec4 _Render = texture2D(_Texture, UV);

            float _Alpha = min(_Result.a, _Render.r * _Render.g * _Render.b);
            if(_Overlay)
                _Result.rgb = mix(_Result.rgb, _Render.rgb, _Alpha);
            else
                _Result.a = _Alpha;

        _Result = mix(_Render_Texture, _Result, _Mixing);
    gl_FragColor = _Result;
}

//@End
/* ####################################################### */

/***********************************************************/
/* Textures */
/***********************************************************/

texture T_Image;

/***********************************************************/
/* Variables */
/***********************************************************/

float _Mixing;
vector _ColorKey;

/***********************************************************/
/* Tech Main */
/***********************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;                     // sampler2D S2D_Image      : register(s0);
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;         // c0
        PixelShaderConstant[1] = <_ColorKey>;       // c1
        PixelShader = asm
        {
            ps.1.1;
            
            /** Consts **************************************************/
            def c2, -1, -1, -1, 0;

            def c3, 1, 0, 0, 0;

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);
            */
            tex t0;
            
            /** Assembly ************************************************/

                mad r0.xyz, c1, c2, t0;
                dp3 r0, r0, r0;
                dp3 r1, c3, c0;
                dp3 t1, c3, c0;
                add r1.w, r1.w, t1.w;
                mul_sat r0.w, 1-r0.w, r1.w;
                mul r0.w, t0.w, r0.w;
            + mov r0.xyz, t0;
        };
    }
}
/* ####################################################### */

/***********************************************************/
/* Samplers */
/***********************************************************/

texture T_Image;

/***********************************************************/
/* Varibles */
/***********************************************************/

    float _Mixing;

/************************************************************/
/* Tech Main */
/************************************************************/

technique tech_main
{
    pass P0
    {
        Texture[0] = <T_Image>;
        MinFilter[0] = LINEAR;
        MagFilter[0] = LINEAR;
        MipFilter[0] = LINEAR;
        AddressU[0] = WRAP;
        AddressV[0] = WRAP;

        PixelShaderConstant[0] = <_Mixing>;

        PixelShader = asm
        {
            ps.1.1

            /** Consts ************************************************/
            def c1, 0, 0, 0, 0.5
            def c2, 0, 0, 0, 0
            def c3, 0, 0, 0, 1
            def c4, 0, 0, 0, -1

            /** Samplers ************************************************/
            /*
                t0 -> float4 _Render_Texture = tex2D(S2D_Image, In);

                t0 -> In : TEXCOORD0;
            */
            texld r0, t0

            
            add r1.w, -r0.w, c1.w
            cmp r1.w, r1.w, c2.w, c3.w
            mul r2.w, c0.x, c4.w
            + mov r1.xyz, r0
            add r2.w, r2.w, c3.w
            mul r0, r0, r2.w
            mad r0, r1, c0.x, r0
        };
    }
}
